#!/usr/bin/env bash
# build-manifest — regenerate plugin/payload/MANIFEST from what is actually in it.
#
# The manifest is the allowlist the installer reads, so it has to match the tree
# exactly: a file present but unlisted never reaches adopters, and a file listed
# but absent makes the install die. Keeping it in sync by hand fails silently in
# both directions, so it is generated, and CI checks the generated form matches
# what is committed.
#
#   bin/build-manifest           rewrite plugin/payload/MANIFEST
#   bin/build-manifest --check   exit 1 if it is out of date, or if a namespaced
#                                file has escaped the namespace (for CI)
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

PAYLOAD="plugin/payload"
MANIFEST="$PAYLOAD/MANIFEST"

# Which files are the project's own from the moment they land. Everything else
# riprap owns and refreshes wholesale. Keep this list short — a seed file is one
# riprap can never improve for an existing adopter.
is_seed() {
  case "$1" in
    bin/test|bin/lint|bin/format|bin/setup) return 0 ;;
    bin/hooks/git/pre-commit|bin/hooks/git/pre-push) return 0 ;;
    # A project that already ignores tmp/ its own way keeps that. Refreshing this
    # one would overwrite whatever else they had put in it.
    tmp/.gitignore) return 0 ;;
    *) return 1 ;;
  esac
}

# The namespace invariant. Every file riprap owns must live somewhere riprap
# owns, and this is what makes that checkable rather than merely intended: an
# installer that overwrites a path outside the namespace is overwriting
# something that might be the adopter's.
#
# This fires at pull-request time. The installer has the matching runtime check,
# but by then the file is already on someone else's disk.
in_namespace() {
  case "$1" in
    bin/hooks/riprap/*|bin/riprap) return 0 ;;
    *) return 1 ;;
  esac
}

generate() {
  cat <<'HDR'
# MANIFEST — the allowlist of record.
#
# Every file riprap installs into a project is named here. Nothing is copied
# because it happens to sit in the payload; the installer reads THIS file and
# refuses anything not listed.
#
# That is deliberate. A recursive copy will happily carry a .pyc, a .DS_Store, or
# an editor backup into someone else's public repo — and a compiled artifact
# embeds absolute source paths and identifiers that no text scrubber can see
# inside.
#
# Two tiers:
#   namespaced  riprap owns it. Overwritten wholesale on every install, and
#               pruned when upstream stops shipping it. Always under
#               bin/hooks/riprap/ or bin/riprap, so it can never collide with
#               anything the project already had.
#   seed        the project's own from the moment it lands; never overwritten.
#
# Generated by bin/build-manifest. Do not hand-edit — CI checks it matches the
# tree, and a hand-edit that drifts fails in whichever direction you did not test.
#
# Format: tier<TAB>path

HDR
  # Deterministic order so the file diffs cleanly.
  (cd "$PAYLOAD" && find . -type f ! -name MANIFEST | sed 's|^\./||' | LC_ALL=C sort) \
  | while IFS= read -r f; do
      if is_seed "$f"; then printf 'seed\t%s\n' "$f"; else printf 'namespaced\t%s\n' "$f"; fi
    done
}

check_namespace() {
  local bad=0 tier path
  while IFS=$'\t' read -r tier path; do
    [ "$tier" = "namespaced" ] || continue
    in_namespace "$path" && continue
    [ "$bad" -eq 0 ] && echo "❌ these are riprap-owned but sit outside the namespace:" >&2
    printf '   %s\n' "$path" >&2
    bad=1
  done < <(generate | grep -vE '^[[:space:]]*(#|$)')

  if [ "$bad" -ne 0 ]; then
    cat >&2 <<'WHY'

Anything riprap overwrites has to live under bin/hooks/riprap/ or be bin/riprap.
Outside the namespace there is no guarantee the path is not already the adopter's,
and the installer would overwrite their file without asking.

Either move it into the namespace, or add it to is_seed() so it is only ever
written when absent.
WHY
    return 1
  fi
  return 0
}

if [ "${1:-}" = "--check" ]; then
  rc=0
  check_namespace || rc=1
  if diff -q <(generate) "$MANIFEST" >/dev/null 2>&1; then
    [ "$rc" -eq 0 ] && echo "✅ MANIFEST is up to date and fully namespaced"
    exit "$rc"
  fi
  echo "❌ MANIFEST does not match $PAYLOAD. Run bin/build-manifest." >&2
  diff <(generate) "$MANIFEST" >&2 || true
  exit 1
fi

check_namespace
generate > "$MANIFEST"
printf '✅ wrote %s (%d entries)\n' "$MANIFEST" \
  "$(grep -cvE '^[[:space:]]*(#|$)' "$MANIFEST")"
