#!/usr/bin/env bash
# check-codex-plugin — native Codex packaging and shared-surface contracts.
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

CLAUDE_MANIFEST=plugin/.claude-plugin/plugin.json
CODEX_MANIFEST=plugin/.codex-plugin/plugin.json
PRE_NATIVE_TAGS=plugin/.codex-plugin/pre-native-tags
EXPECTED_SKILLS="advise architect handoff implement install learn prune release review spec write"

fail=0
problem() { echo "❌ $*" >&2; fail=1; }

for file in "$CLAUDE_MANIFEST" "$CODEX_MANIFEST"; do
  [ -f "$file" ] || { problem "$file is missing"; continue; }
  jq -e . "$file" >/dev/null || problem "$file is not valid JSON"
done

if [ -f "$CLAUDE_MANIFEST" ] && [ -f "$CODEX_MANIFEST" ]; then
  for field in name version description homepage repository author license keywords; do
    claude=$(jq -cS ".$field" "$CLAUDE_MANIFEST")
    codex=$(jq -cS ".$field" "$CODEX_MANIFEST")
    [ "$claude" = "$codex" ] || problem "plugin manifests disagree on $field"
  done
  [ "$(jq -r .skills "$CODEX_MANIFEST")" = "./skills/" ] ||
    problem "Codex manifest does not register ./skills/"
  jq -e '.interface.defaultPrompt | length == 3' "$CODEX_MANIFEST" >/dev/null ||
    problem "Codex manifest must offer exactly three starter prompts"
  jq -e 'has("hooks") | not' "$CODEX_MANIFEST" >/dev/null ||
    problem "Codex manifest must use native default discovery for hooks/hooks.json"
fi

[ -f plugin/hooks/hooks.json ] || problem "shared native lifecycle hooks are missing"
jq -e '
  def events: ["SessionStart", "PreToolUse", "PostToolUse", "PreCompact", "Stop", "SessionEnd"];
  def matchers: ["startup", "resume", "clear", "compact", "fork", "Bash", "Read", "Grep",
                 "Edit", "Write", "ExitPlanMode"];
  type == "object" and (.hooks | type == "object") and
  ((.hooks | keys) - events | length == 0) and
  (events - (.hooks | keys) | length == 0) and
  all(.hooks[];
    type == "array" and length > 0 and all(.[ ];
      type == "object" and
      ((.matcher? // "") | type == "string") and
      (((.matcher? // "") | select(length > 0) | split("|") | . - matchers | length) // 0) == 0 and
      (.hooks | type == "array" and length > 0) and
      all(.hooks[];
        type == "object" and .type == "command" and
        (.command | type == "string" and length > 0) and
        ((.shell? // "bash") | type == "string") and
        ((.async? // false) | type == "boolean") and
        ((.timeout? // 0) | type == "number")
      )
    )
  )
' plugin/hooks/hooks.json >/dev/null || problem "shared hooks do not satisfy the native hook contract"

actual_skills=$(find plugin/skills -mindepth 1 -maxdepth 1 -type d -exec basename {} \; | sort | tr '\n' ' ' | sed 's/ $//')
[ "$actual_skills" = "$EXPECTED_SKILLS" ] ||
  problem "shared skill surface is '$actual_skills', expected '$EXPECTED_SKILLS'"

for doc in README.md CLAUDE.md docs/index.md docs/install.md docs/reference.md docs/rules.md; do
  for skill in $EXPECTED_SKILLS; do
    grep -qF "/riprap:$skill" "$doc" || problem "$doc never names /riprap:$skill"
  done
done

[ -f plugin/skills/install/SKILL.md ] || problem "shared install skill is missing"
[ ! -e plugin/commands/install.md ] || problem "Claude-only install command still duplicates the shared skill"

actual_agents=$(find plugin/agents -mindepth 1 -maxdepth 1 -type f -name '*.md' | wc -l | tr -d ' ')
[ "$actual_agents" = 1 ] && [ -f plugin/agents/agent.md ] ||
  problem "Codex must discover exactly the shared riprap worker agent"

for skill in plugin/skills/*/SKILL.md; do
  grep -qF '${CLAUDE_PLUGIN_ROOT}/instructions/README.md' "$skill" ||
    problem "${skill%/SKILL.md} does not load shared guardrails when the router is absent"
done

for mapping in architect implement review release; do
  grep -q "riprap:$mapping" plugin/agents/agent.md ||
    problem "worker agent lost its $mapping mapping"
done

grep -qF '.riprap/instructions/riprap-skills.md' plugin/agents/agent.md ||
  problem "worker agent does not use neutral stored answers"

for skill in architect prune implement release review; do
  file="plugin/skills/$skill/SKILL.md"
  for contract in '.riprap/instructions/riprap-skills.md' \
                  'write every new or changed answer only to `.riprap/instructions/riprap-skills.md`'; do
    grep -qF "$contract" "$file" || problem "$file is missing neutral-guidance migration contract: $contract"
  done
done

grep -qF 'Read `.riprap/instructions/` first' plugin/instructions/README.md ||
  problem "router does not give neutral project guidance first precedence"
grep -qF 'updated guidance only under `.riprap/instructions/`' \
  plugin/instructions/README.md || problem "router does not make neutral guidance authoritative for writes"
grep -qF 'does not install or mutate user-level Codex configuration' plugin/skills/install/SKILL.md ||
  problem "installer does not disclose the Codex configuration boundary"

if grep -rEl '\.claude/instructions/.*creat|write.*\.claude/instructions|update.*\.claude/instructions' \
  plugin/skills plugin/agents plugin/instructions >/dev/null; then
  problem "published guidance still instructs writes to the legacy Claude directory"
fi

for tool in AskUserQuestion request_user_input; do
  grep -qF "$tool" plugin/instructions/interaction-preferences.md ||
    problem "interaction preferences do not name $tool"
done
grep -qF 'Plan mode' plugin/instructions/interaction-preferences.md ||
  problem "Codex structured choices do not define their Plan-mode checkpoint"

grep -qF 'On Codex, read' plugin/agents/agent.md ||
  problem "worker agent has no Codex-native skill invocation path"

for doc in README.md docs/index.md docs/install.md docs/guardrails.md docs/rules.md \
           plugin/instructions/README.md plugin/instructions/project-standards.md \
           plugin/skills/install/SKILL.md; do
  if grep -Eq 'Codex.{0,100}(does not expose|no native session-start|missing lifecycle|relies on.{0,30}repository-side)' "$doc"; then
    problem "$doc still claims Codex lacks native lifecycle hooks"
  fi
done

[ -s "$PRE_NATIVE_TAGS" ] || problem "$PRE_NATIVE_TAGS is missing or empty"
if [ -s "$PRE_NATIVE_TAGS" ]; then
  while IFS= read -r tag; do
    git rev-parse -q --verify "refs/tags/$tag^{commit}" >/dev/null ||
      problem "$PRE_NATIVE_TAGS names nonexistent tag $tag"
    if git cat-file -e "$tag:$CODEX_MANIFEST" 2>/dev/null; then
      problem "$PRE_NATIVE_TAGS still names $tag even though it has a Codex manifest"
    fi
  done < "$PRE_NATIVE_TAGS"
fi

[ "$fail" -eq 0 ] || exit 1
echo "✅ native Codex plugin contract holds"
