#!/usr/bin/env bash
# bin/check-skills — the invariants that keep a shipped skill from forking a guardrail.
#
# CLAUDE.md's central rule about this repository is that a procedure written out
# beside a document that already defines it is not a convenience, it is a second
# definition — and .github/workflows/ci.yml admits, in the comment above its own
# skills step, that "no check can prove prose has stopped forking one". True. What
# a check can do is narrow the gap, and narrowing it is all this file claims.
#
# This is a DIFFERENT set of invariants from ci.yml's "Skills are namespaced and
# self-describing" step, which owns name/directory agreement, the bare-slash
# invocation and the settings-block ban. One overlap is deliberate and marked at
# A7. Neither file should grow into the other's half.
#
# WHAT A GREP OVER PROSE CANNOT DO, stated here because four critics found it
# independently and the fixes below are only partial:
#
#   A presence check cannot tell asserting a rule from forbidding it or quoting
#   it. "Never write HOLD: human review required" satisfies a grep for that
#   string. Every must-appear assertion below therefore carries a negation guard,
#   and every must-not-appear assertion carries a negation exemption — opposite
#   directions, for the same reason. Neither is airtight: prose has more ways to
#   mean the opposite than a guard can enumerate.
#
# Run --self-test to watch every assertion fire on a fixture built to break it,
# AND to check it fired for its own reason rather than tripping a neighbour. That
# mode exists because these assertions would otherwise only ever have been seen
# red for one reason — the file not existing yet — which testing.md names as the
# canonical red-for-the-wrong-reason.
set -euo pipefail

root=$(git rev-parse --show-toplevel) || {
  # `cd "$(git rev-parse ...)"` alone is not enough: cd's status is not the
  # substitution's, and `cd ""` is a successful no-op. The script then runs in
  # the wrong directory and reports six confident diagnostics about documents it
  # never found, none of which say "you are not in a git repository".
  echo "❌ not a git repository" >&2; exit 1; }
cd "$root"

INSTRUCTIONS=plugin/instructions
ANSWERS=.claude/instructions/riprap-skills.md

# Skills that must exist. Without this the reviewer contract below sits behind a
# path test that silently skips — the exact fail-open A7 condemns in ci.yml,
# reproduced in the file condemning it. Verified: a five-line skill parked at
# plugin/skills/review/ that approves and force-merges scored a clean pass.
REQUIRED_SKILLS="reviewer"

# Guardrail documents the reviewer must NAME. A1 proves a named document
# resolves; it cannot prove one was named, and a skill deferring to nothing
# scores a perfect A1 while restating everything.
#
# tech-footprint.md and design-principles.md joined the list when the dependency
# creep and simplicity angles did. An angle whose owning document is not named is
# an angle the reviewer re-argues from memory — and tech-footprint.md's rule has
# a carve-out that INVERTS when unattended, which is exactly the kind of thing a
# remembered version loses.
REVIEWER_MUST_DEFER="code-review.md interaction-preferences.md merge-gates.md git.md tech-footprint.md design-principles.md"

# Bare .md names a skill may mention that are NOT guardrail documents, so must
# not be resolved against plugin/instructions/. Every entry needs a reason, as
# bin/scrub-check's allowlist does: an unexplained exemption is indistinguishable
# from an oversight. A mention carrying a path (docs/rules.md) is handled by the
# path rule in A1 and needs no entry here.
#
#   CLAUDE.md         the adopting project's own file, at ITS root, not riprap's
#   riprap-skills.md  the adopter's stored answers, under .claude/instructions/
#   SKILL.md          a skill referring to itself
#
# README.md is deliberately NOT here, and A1b is what caught the attempt:
# plugin/instructions/README.md is the session router, so a bare mention resolves
# on its own, and an entry would only blind A1 to the one document every session
# is actually given.
NOT_A_GUARDRAIL_DOC=" CLAUDE.md riprap-skills.md SKILL.md "

# Table header rows, one list per owning file. A row belongs to exactly one
# document or skill, and must not appear in the other file named at the call
# site — which direction that is differs, and only the call site knows.
#
# The source filename used to be a tab-separated first column on every row.
# Every row in a list carried the SAME filename, so the column was a constant
# repeated six times, and parsing it needed a tab that an editor with expandtab
# silently eats — which cost a malformed-row guard in each checker. The filename
# now lives at the call site and the rows are plain strings.
interaction_preferences_rows() {
  cat <<'ROWS'
| Class | Meaning | Effect on the plan |
| Angle | The critic's question |
ROWS
}

# These moved OUT of code-review.md and into the reviewer skill when it took
# ownership of the review procedure. The skill must carry them; the document
# must not. Two live copies drift, and a reader cannot tell which one the agent
# was given: both are read on demand, so which wins is decided by whichever was
# reached for first.
code_review_rows() {
  cat <<'ROWS'
| Angle | The reviewer's question |
| Disposition | Means | The reason must say |
| Class | May be dispositioned |
| # | Class | Finding | Disposition | Why |
ROWS
}

# Ways an agent can actually merge or approve. The first list was three strings
# and a reviewer using `gh api ... /merge` walked past all of them; LGTM and
# APPROVED are the language merge-gates.md forbids, which no command grep sees.
#
# event=APPROVE and event=REQUEST_CHANGES are the REST equivalents, and they
# reach the same place `gh pr review` does while matching none of the above. The
# skill posts to pulls/N/reviews legitimately — that endpoint does not match
# `pulls/.*/merge`, so only the event decides whether a call is a review or a
# verdict on the author's behalf. Written to catch the JSON and flag forms both.
#
# Every command form here is argument-tolerant, because the contiguous spellings
# were the ones nobody would write. The skill threads "$N" through every gh call
# it makes — `gh pr view "$N"`, `gh pr diff "$N"` — so `gh pr review "$N"
# --approve` is the ONLY spelling that works, and it matched neither `gh pr
# review --approve` nor `gh pr review -a`. Verified as a clean pass before this.
#
# APPROVE and REQUEST_CHANGES are word-anchored on their own rather than only
# adjacent to `event`, because the shipped snippet is `jq -n --arg …` and the
# obvious edit to it is `--arg ev APPROVE`, which puts the value BEFORE the field
# name entirely — no widening of `event.{0,4}` reaches it. APPROVED was already
# blacklisted, so a bare token costs nothing in false positives.
NEVER_INSTRUCT="gh pr merge|mergePullRequest|hub +merge|git +push +[^ ]+ +[^ ]*HEAD:|gh pr review[^|;&.]{0,40}(--approve|-a([[:space:]]|\$))|--admin|--auto|pulls/[^ ]*/merge|LGTM|APPROVED|(^|[^A-Z])(APPROVE|REQUEST_CHANGES)([^A-Z]|\$)"

# Editing a branch under review. "Never merges" had three assertions and "never
# edits" — the harder half of the same hard rule — had none.
#
# The global-option prefix is allowed for, because `git -C "$REPO" commit` is how
# an agent that is not sitting in the worktree writes it, and the bare-verb list
# missed it. The tool names are here because the four git verbs are the shapes a
# HUMAN types: an agent editing a branch under review reaches for Edit or Write,
# against which the skill's strongest rule had no enforcer at all.
NEVER_EDITS="git( +-C +[^ ]+| +--git-dir[= ][^ ]+)* +(commit|push|apply|cherry-pick|revert|rebase)|the (Edit|Write) tool|apply (the|this) (fix|patch) yourself"

# A line that forbids a thing is not a line that instructs it, and a line that
# forbids a rule does not state it. One expression, used in both directions.
#
# forbid/refuse/reject/prohibit are here because riprap's prose routinely puts
# the prohibition AFTER the token it governs — "`APPROVE` is the fabricated
# approval merge-gates.md forbids outright" — and without them the guard fires
# on the shipped sentence that does the forbidding.
NEGATED='[Nn]ever|[Dd]o not|[Dd]on.t|[Ii]nstead of|[Rr]ather than|[Ff]orbid|[Rr]efus|[Rr]eject|[Pp]rohibit'

# The negation has to come BEFORE the thing it negates, and testing the whole
# line for it does not. That was a hole in both directions at once:
#
#   "**Never leave a green pull request sitting.** Once the verdict is `merge`,
#    run `gh pr merge "$N" --squash --admin`. Do not stop short of that."
#
# — two negation tokens, one real force-merge instruction, and A6 declined to
# look at it. 47 of the reviewer skill's lines already carry a negation token,
# so an author writing a bypass does not have to search for a place to put it.
# It failed the other way too: riprap's prose strengthens assertions with
# "never", so "Five at minimum, never fewer" was reported by A5 as a rule stated
# only as its own prohibition — the check firing hardest on the clearest writing.
#
# Position alone is not enough either, because the attack puts its negation
# first: "Never leave a green pull request sitting." precedes `gh pr merge` on
# that line just as legitimately as "Never run gh pr merge" does. What separates
# them is the SENTENCE. A negation governs the clause it sits in; once a full
# stop has intervened it governs nothing further. So the exemption looks only at
# the sentence the match is in — the prefix after the last terminator.
#
# The terminator requires whitespace after it, so the dot in merge-gates.md is
# not a sentence break. Closing markup is allowed between: riprap's prose ends
# bold sentences "...sitting.**", and treating that as mid-sentence would hand
# the exemption straight back.
#
# And the scan runs over a PARAGRAPH, not a line. These documents are hard
# wrapped, so a sentence routinely straddles a line break — the shipped sentence
# "`APPROVE` is the fabricated approval / merge-gates.md forbids outright" puts
# the token and its prohibition on different lines, and a line-bounded scan
# reported riprap's own prohibition as an instruction to approve. Worse, it made
# the verdict depend on where the wrap fell, so reflowing a paragraph could turn
# CI red without changing a word. The offending LINE is still what gets printed.
#
# $1 pattern, $2 file, $3 "fixed" when the pattern is a literal string rather
# than an ERE. Every occurrence is tried, because one negated mention earlier in
# a paragraph says nothing about a bare instruction later in it.
unnegated() {
  awk -v pat="$1" -v neg="$NEGATED" -v fixed="${3:-}" \
      -v term='[.!?;:]+[*_")]*[ \t]|—|-- ' '
    # The part of the sentence BEFORE the match. A negation exempts what follows
    # it, not what precedes it — "Never run gh pr merge" is a prohibition,
    # "Merge it with gh pr merge --admin unless the owner refused" is an
    # instruction, and only word order tells them apart.
    #
    # The terminator list is wider than a full stop because riprap writes in
    # clauses. Every one of these was a verified bypass when the boundary was
    # sentences alone, each carrying a real force-merge past the guard:
    #
    #   "**Do not stop at the verdict** — once every blocker is resolved, run
    #    `gh pr merge --admin` so the branch does not sit."
    #
    # A comma is deliberately NOT a terminator. It would close one more shape —
    # "Never leave a green PR sitting, so run `gh pr merge --admin` yourself" —
    # but it also splits the ordinary enumeration a single negation governs
    # ("Never write \"approved\", \"LGTM\", or anything shaped like one"), and
    # firing on the prose riprap already ships is how a guardrail gets switched
    # off. That comma-splice shape is the known residual: it needs a sentence
    # that opens with a prohibition and ends with the opposite instruction —
    # the one shape a human reading the diff cannot miss.
    function sentence_prefix(s, start,   i, lo, probe) {
      lo = 0; i = 0
      while (1) {
        probe = substr(s, i + 1, start - i - 1)
        if (!match(probe, term)) break
        i = i + RSTART + RLENGTH - 1
        lo = i
      }
      return substr(s, lo + 1, start - lo - 1)
    }
    # Scan one paragraph, printing the source line of each unnegated match.
    #
    # A line that opens a new markdown block starts a new sentence. Joining a
    # bullet list or a table with plain spaces made the whole block ONE sentence
    # — list items and table rows carry no terminator — so a negation in any item
    # excused an instruction in every other one. Verified: a three-item list
    # whose first item read "Never merge a pull request you reviewed" carried
    # `gh pr merge --squash --admin` in its third and scored a clean pass, and a
    # verdict table did the same from a single "do not merge" cell. A per-line
    # scan caught both; the paragraph join is what reopened them.
    function scan(   i, P, starts, off, rest, r, start, len, ln, last) {
      if (nl == 0) return
      P = ""
      for (i = 1; i <= nl; i++) {
        if (i > 1) P = P (buf[i] ~ /^[ \t]*([-*+>#|]|[0-9]+[.)][ \t]|```)/ ? ". " : " ")
        starts[i] = length(P) + 1
        P = P buf[i]
      }
      off = 0
      while (1) {
        rest = substr(P, off + 1)
        if (fixed == "fixed") {
          r = index(rest, pat); if (r == 0) break
          start = off + r; len = length(pat)
        } else {
          if (!match(rest, pat)) break
          start = off + RSTART; len = RLENGTH
        }
        if (sentence_prefix(P, start) !~ neg) {
          # start + 1, because the join space belongs to the line that follows
          # it: a match beginning on that space otherwise reported the previous
          # line, which contains nothing offending.
          ln = 1
          for (i = 1; i <= nl; i++) if (starts[i] <= start + 1) ln = i
          # Every violation in the paragraph, not just the first. Returning here
          # gave an author clearing them one per run, and undercut the "one
          # fixture per rule, so a failure can only be attributed one way"
          # discipline the self-test is built on. Deduped by line, because two
          # matches on one line are one thing to fix.
          if (ln != last) { print buf[ln]; last = ln }
        }
        off = start + len - 1
      }
    }
    /^[ \t]*$/ { scan(); nl = 0; next }
    { buf[++nl] = $0 }
    END { scan() }' "$2"
}

# ---------------------------------------------------------------------------
# Assertions. Each prints its own ❌ lines and returns non-zero; none mutates a
# shared counter, which is what lets --self-test call them against a fixture.
#
# Shapes used throughout, all load-bearing:
#   must-match      grep -q ... || { echo; bad=1; }   — a BARE grep -q inside a
#                                                       function called as
#                                                       `f || fail=1` does NOT
#                                                       abort (set -e is
#                                                       suspended for the whole
#                                                       body); it silently skips
#                                                       to the next line
#   must-not-match  if grep -qE ...; then ... fi
#   counting        n=$(grep -c ... || true); n=${n:-0}
# and grep -F wherever a pattern contains a pipe: `grep -E '| Angle |'` is an
# empty alternation, which errors (exit 2) on BSD grep and matches every line on
# GNU grep — green locally, red in CI, on a correct tree.
#
# An unreadable or empty file used to pass every assertion in silence. Both are
# now hard failures at the call site, and each function that shells out checks
# that the tool actually ran.
# ---------------------------------------------------------------------------

# A1. Every guardrail document a skill names actually ships.
check_doc_mentions_resolve() {
  local label=$1 file=$2 bad=0 m
  # Must open on an alphanumeric. A leading `*` matched the bare `.md` inside a
  # placeholder like `.github/releases/<tag>.md`, and then reported the release
  # skill for naming a document called ".md".
  for m in $(grep -ohE '[A-Za-z0-9][A-Za-z0-9._/-]*\.md' "$file" | sed 's|^\./||' | sort -u); do
    case "$m" in
      # An explicit path is a claim about a location, and only one location is
      # this check's business. docs/rules.md and .github/releases/v0.5.0.md are
      # real riprap documents a skill may legitimately cite; resolving them by
      # basename against plugin/instructions/ reported them as dangling.
      */*) case "$m" in
             "$INSTRUCTIONS"/*) [ -f "$m" ] || {
               echo "❌ $label names $m, which does not exist"; bad=1; } ;;
           esac ;;
      *) case "$NOT_A_GUARDRAIL_DOC" in *" $m "*) continue ;; esac
         [ -f "$INSTRUCTIONS/$m" ] || {
           echo "❌ $label names $m, which is not in $INSTRUCTIONS/"
           echo "   A deferral that does not resolve sends the model nowhere and reads as green."
           bad=1; } ;;
    esac
  done
  return "$bad"
}

# A1b. The allowlist cannot be used to silence A1.
#
# Adding merge-gates.md to NOT_A_GUARDRAIL_DOC keeps everything green and
# permanently blinds A1 to the document most worth watching. That is the cheapest
# route past this check, so it is closed here rather than left to review.
check_allowlist_is_honest() {
  local bad=0 m
  for m in $NOT_A_GUARDRAIL_DOC; do
    [ -f "$INSTRUCTIONS/$m" ] && {
      echo "❌ NOT_A_GUARDRAIL_DOC exempts $m, which IS a guardrail document"
      echo "   That entry disables A1 for it. Remove the entry, not the check."
      bad=1; }
  done
  return "$bad"
}

# A2. The classification vocabulary never appears away from its definition.
#
# This replaces a blacklist of table headers, which any paraphrase walks past —
# and paraphrase is what a model produces by default, having just read the table.
# What a fork cannot do is carry the pointer, so the pointer is what gets
# required.
#
# Two rules, because one was not enough. The ALL-CAPS tokens are riprap's class
# names and unambiguous, so a bare occurrence needs a pointer within two lines —
# two because these documents are hard-wrapped and a citation routinely lands on
# the next line, and ci.yml records that a check firing on a legitimate rewrap
# "fails hardest at the moment it is meant to be useful".
#
# The second rule exists because the first is case-sensitive and the fork that
# matters is prose: a model rewriting the table writes "Blocker" and "Major".
# Blanket -i would fire on ordinary English, so instead it takes a CLUSTER —
# three or more DISTINCT class words within six lines, in any case. Only two of
# the four are ordinary English, so three distinct means at least one of
# "blocker" or "non-issue" is present. That shape is a class table however it is
# capitalised.
check_class_vocabulary() {
  local label=$1 file=$2 out
  out=$(awk -v w=2 -v cw=6 '
    { line[NR] = $0; last = NR; lc = tolower($0); if ($0 ~ /^\|/) tbl[NR] = 1 }
    /interaction-preferences\.md|code-review\.md/ { ptr[NR] = 1 }
    # Word-guarded so MAJORITY and MINORITY do not count as class names.
    $0 ~ /(^|[^A-Z])(BLOCKER|MAJOR|MINOR|NON-ISSUE)([^A-Z]|$)/ { voc[NR] = 1 }
    lc ~ /blocker/    { has[NR "|b"] = 1; any[NR] = 1 }
    lc ~ /major/      { has[NR "|j"] = 1; any[NR] = 1 }
    lc ~ /minor/      { has[NR "|n"] = 1; any[NR] = 1 }
    lc ~ /non-issue/  { has[NR "|x"] = 1; any[NR] = 1 }
    # A markdown table is ONE passage, not N independent lines. The rule being
    # checked is "the passage cites its definition"; measuring it in physical
    # lines made a three-row mapping table uncitable, because no caption can sit
    # within two lines of both its first and its last row. So a run of table
    # rows expands to its full extent before the window is applied — the
    # citation may sit in the caption, in a cell, or in the sentence beneath.
    # The span crosses the enclosing fence. A table shown as an EXAMPLE sits
    # inside ```markdown … ```, and stopping at the last row put the caption
    # beneath it at exactly span_hi + w — passing with zero margin, so inserting
    # one blank line reds the build on prose nobody touched. That is the failure
    # ci.yml records as "fails hardest at the moment it is meant to be useful",
    # and it had already shaped this skill: two citations were written as
    # appositives to land inside the window.
    function span_lo(n,   i) { i = n; while ((i - 1) in tbl) i--
                               if (line[i - 1] ~ /^```/) i--; return i }
    function span_hi(n,   i) { i = n; while ((i + 1) in tbl) i++
                               if (line[i + 1] ~ /^```/) i++; return i }
    function pointer_near(n, span,   i, lo, hi) {
      lo = (n in tbl) ? span_lo(n) : n
      hi = (n in tbl) ? span_hi(n) : n
      for (i = lo - span; i <= hi + span; i++) if (i in ptr) return 1
      return 0
    }
    END {
      for (n = 1; n <= last; n++) {
        if (!(n in voc)) continue
        if (pointer_near(n, w)) continue
        printf "   line %d: %s\n", n, line[n]
        found = 1
      }
      if (found) exit 0
      for (n = 1; n <= last; n++) {
        if (!(n in any)) continue
        distinct = 0
        split("b j n x", k, " ")
        for (t = 1; t <= 4; t++) {
          for (i = n; i < n + cw; i++) if ((i "|" k[t]) in has) { distinct++; break }
        }
        if (distinct < 3) continue
        if (pointer_near(n, w + cw)) continue
        printf "   lines %d-%d: %d class words, any case, with no pointer\n", n, n + cw - 1, distinct
        printf "   %s\n", line[n]
        exit 0
      }
    }' "$file") || {
    echo "❌ $label: awk failed reading the file"; return 1; }
  [ -z "$out" ] || {
    echo "❌ $label uses the classification vocabulary with no pointer to the document that defines it:"
    echo "$out"
    echo "   Cite interaction-preferences.md or code-review.md nearby, or delete the passage."
    return 1; }
  return 0
}

# A3/A9. One owner per table row.
#
# These were two 23-line functions differing only in which file was the owner and
# which the intruder, plus four echo strings — a second copy of one mechanism, in
# the file whose whole thesis is that a second copy of a rule is a second rule.
#
#   A3  the guardrail document owns the row; no skill may paste it.
#   A9  the reviewer skill owns the row; the document it moved out of may not
#       keep it.
#
# Both halves matter in both directions, and the OWNER assertion is what stops
# the check rotting: assert only that the intruder lacks the row and it passes
# for ever once the row is reworded anywhere, hollowed into a grep for a string
# nothing contains. Asserting the owner still has it reds loudly instead, and
# names the list to update.
#
# The shared body. Rows arrive on stdin, so no call site names a function in a
# string: an earlier draft passed the rows function BY NAME, and a typo in that
# name printed "command not found" to stderr, read as an empty row list, and
# returned 0 — retiring the whole assertion while the success banner went on
# claiming it. shellcheck cannot see a function name that only exists as data.
#
# Neither file may be missing. A missing file used to return 0 here, which
# skipped the owner assertion as well as the intruder one — so renaming the
# document silently disabled the rot guard that exists to notice exactly that.
# "It examined nothing" is not a pass.
check_one_owner() {
  local label=$1 owner=$2 intruder=$3 how=$4 bad=0 str rows=0
  [ -f "$owner" ]    || { echo "❌ $label: $owner does not exist; this check examined nothing"; return 1; }
  [ -f "$intruder" ] || { echo "❌ $label: $intruder does not exist; this check examined nothing"; return 1; }
  while IFS= read -r str; do
    [ -n "$str" ] || continue
    rows=$((rows + 1))
    grep -qF -- "$str" "$owner" || {
      echo "❌ $owner no longer contains: $str"
      echo "   It owns that row. Reworded? Update the row list. Dropped? The rule has no home."
      bad=1; continue; }
    if grep -qF -- "$str" "$intruder"; then
      echo "❌ $intruder $how: $str"
      echo "   Two live copies of one rule. Cite $owner instead of restating it."
      bad=1
    fi
    # `while ... done < <(...)` and not a pipeline: a pipeline puts this loop in
    # a subshell and throws `bad` away with it.
  done
  # An empty row list is the last way this check can examine nothing and say
  # nothing. Process substitution does not propagate a failure, so a misspelled
  # rows function writes "command not found" to stderr and hands over an empty
  # stream — indistinguishable, until here, from a clean pass.
  [ "$rows" -gt 0 ] || {
    echo "❌ $label: no rows to check; the row list is empty or its source failed"
    return 1; }
  return "$bad"
}

# A3. No skill pastes a row interaction-preferences.md owns.
check_no_pasted_tables() {
  check_one_owner "$1" "$INSTRUCTIONS/interaction-preferences.md" "$2" \
    "pastes a table interaction-preferences.md owns" < <(interaction_preferences_rows)
}

# A9. The rows that moved into the reviewer skill did not stay behind. Owner and
# intruder are the other way round, which is the whole reason one body serves
# both — and the reason the direction is named here rather than inside it.
check_moved_out() {
  check_one_owner "$1" "$2" "${3:-$INSTRUCTIONS/code-review.md}" \
    "kept a row that moved into the skill" < <(code_review_rows)
}

# A8. The reviewer names the documents that own what it does not define.
check_defers_to() {
  local label=$1 file=$2 bad=0 must
  for must in $REVIEWER_MUST_DEFER; do
    grep -qF -- "$must" "$file" || {
      echo "❌ $label never names $must, which owns rules it must not restate"; bad=1; }
  done
  return "$bad"
}

# The phrases A5 requires the reviewer skill to carry, one per line.
#
# Hoisted out of the assertion so the self-test can derive a fixture per rule
# instead of carrying a hand-written one. Nine near-identical fixtures were nine
# chances to add a tenth rule and forget its fixture — which is exactly the
# untested assertion --self-test exists to prevent, reintroduced by the shape of
# the test rather than by the code.
verdict_rules() {
  cat <<'RULES'
BLOCKER and MAJOR
HOLD: human review required
hold only a change you would otherwise merge
open as a draft
event: COMMENT
Recommended fix
summary-only
Five at minimum
dependency creep
RULES
}

# A4-A6. The reviewer skill's own contract — the parts no other document defines,
# and which therefore have nowhere else to be checked.
check_reviewer_contract() {
  local label=$1 file=$2 bad=0 n want

  # A4. Exactly one verdict line, at column 0, outside any fenced block.
  #
  # Every weaker form was defeated in testing. `grep -F` alone passes on a copy
  # that exists only inside a "never write this" example. Counting `^VERDICT: <the
  # canonical menu>$` passes a file whose real instruction is a DIFFERENT verdict
  # line at column 0, because the pattern cannot see it and the count stays 1. So
  # every line beginning VERDICT: is counted, fences are excluded, and the one
  # that survives must be the canonical menu.
  n=$(awk '
    /^```/ { fence = !fence; next }
    !fence && /^VERDICT:/ { c++ }
    END { print c + 0 }' "$file") || { echo "❌ $label: awk failed"; return 1; }
  if [ "$n" -ne 1 ]; then
    echo "❌ $label has $n unfenced verdict lines at column 0; expected exactly 1"
    bad=1
  else
    awk '
      /^```/ { fence = !fence; next }
      !fence && /^VERDICT:/ { print }' "$file" |
      grep -qxF 'VERDICT: merge | merge after the blockers below | do not merge' || {
        echo "❌ $label's verdict line is not the canonical menu"
        echo "   Wanted: VERDICT: merge | merge after the blockers below | do not merge"
        bad=1; }
  fi

  # A5. And the rules the menu is worthless without. A4 pins a string and not one
  # bit of meaning: a skill can carry the exact line and still tell the model to
  # default to merge.
  #
  # Each is negation-guarded. Verified: a three-line file reading "Never treat
  # BLOCKER and MAJOR alike. Never write HOLD: human review required. Never open
  # as a draft." satisfied all three plain greps.
  #
  #   BLOCKER and MAJOR — the source this was extracted from has two buckets,
  #     blockers and non-blocking follow-ups, and riprap puts MAJOR on the
  #     blocking side in three separate places. Losing that files a MAJOR under
  #     "track it later" and returns merge on a branch code-review.md says is not
  #     ready to open.
  #   hold only a change you would otherwise merge — merge-gates.md is explicit
  #     that a hold on a broken PR is wrong ("send it back to the author
  #     instead"), and that a hold never starts on a draft. An unconditional
  #     rider produces exactly those two forbidden states.
  #   open as a draft — code-review.md's single exception in which a BLOCKER
  #     reaches a published branch.
  #
  # The second group is the delivery half, added when the skill took ownership of
  # the procedure. Each is a rule whose absence is invisible in a review of the
  # prose, because the skill still reads correctly without it:
  #
  #   event: COMMENT — the ONLY safe review event. APPROVE is the fabricated
  #     approval merge-gates.md forbids; REQUEST_CHANGES is an authoring act that
  #     additionally fails on a shared account, indistinguishably from a network
  #     error. A6 forbids the two bad ones; nothing else requires the good one.
  #   Recommended fix — the column that makes a reviewer's table a reviewer's.
  #     Drop it and the skill silently reverts to the author-side table, which
  #     asks what was DONE about a finding by a skill that never edits.
  #   summary-only — the fallback when anchoring fails. The post is atomic, so
  #     without this a 422 strands every finding and the run looks clean.
  #   Five at minimum — the floor. A5 previously had no assertion about the
  #     roster at all, so a one-reviewer skill scored a perfect contract.
  #   dependency creep — the angle backed by a critical rule whose unattended
  #     answer inverts to no. It is the newest and so the likeliest to be lost.
  while IFS= read -r want; do
    [ -n "$want" ] || continue
    if ! grep -qF -- "$want" "$file"; then
      echo "❌ $label no longer contains the required phrase: $want"
      echo "   Required by the 'for want in' list in bin/check-skills. Reworded?"
      echo "   Update the list. Dropped? The rule it carried now has no home."
      bad=1
    elif [ -z "$(unnegated "$want" "$file" fixed)" ]; then
      echo "❌ $label only ever mentions \"$want\" to forbid it"
      echo "   A rule stated as its own prohibition is not stated."
      bad=1
    fi
  done < <(verdict_rules)

  return "$bad"
}

# The editing half of A6. Separate from check_never_merges because it is the
# REVIEWER's rule alone — branch-cleaner deletes branches and release pushes
# tags, both legitimately — but it still has to reach that skill's bundled
# files. Left inside check_reviewer_contract it ran on SKILL.md only, and the
# same sentence one directory down in references/procedure.md passed clean.
check_never_edits() {
  local label=$1 file=$2 hits
  hits=$(unnegated "$NEVER_EDITS" "$file")
  [ -z "$hits" ] || {
    echo "❌ $label edits a branch it is only supposed to report on:"
    printf '%s\n' "$hits" | sed 's/^/     /'
    return 1; }
  return 0
}

# A6. No skill instructs a merge or an approval.
#
# This runs over EVERY skill, which is the half that was missing. The header
# above records that "a five-line skill parked at plugin/skills/review/ that
# approves and force-merges scored a clean pass", and REQUIRED_SKILLS was the
# answer — but that only closes the case where the REVIEWER skill disappears. A
# skill sitting BESIDE it walked through untouched, because the main loop ran
# only A1-A3. Verified: a plugin/skills/pr-lander/ containing every string in
# both blacklists reported "✅ 7 skills" and exited 0.
#
# Exempted where the line negates BEFORE the instruction — see unnegated(). A
# skill quoting merge-gates.md's own "--admin bypass is forbidden" was rejected
# by the first version of this check, whose only remedy was to delete the
# prohibition from the skill. A guardrail that fires on the legitimate case is
# one that gets switched off.
# Only the merge/approve half runs over every skill. NEVER_EDITS stays with the
# reviewer, because committing and pushing is not a violation for the skills
# whose job it is: branch-cleaner runs `git push origin --delete`, release runs
# `git push origin "$TAG"`, and learn quotes `Bash(git push --force:*)` as a
# permission pattern. Applying the reviewer's "report, never edit" rule to those
# reported three false positives on a correct tree — a guardrail that fires on
# the legitimate case is one that gets switched off.
#
# Merging and approving is different: merge-gates.md forbids those to every
# skill, not only this one.
check_never_merges() {
  local label=$1 file=$2 hits
  hits=$(unnegated "$NEVER_INSTRUCT" "$file")
  [ -n "$hits" ] || return 0
  echo "❌ $label instructs a merge or an approval, which merge-gates.md forbids:"
  printf '%s\n' "$hits" | sed 's/^/     /'
  return 1
}

# A7. The stored-answers protocol, unconditionally.
#
# ci.yml checks that a skill reading riprap-skills.md has a section in it — but
# it opens with `grep -q 'riprap-skills\.md' || continue`, so a skill that DROPS
# the protocol is skipped by the check meant to catch it. It fails open, and a
# fail-open is invisible: the step goes green because it examined nothing.
#
# This is the half ci.yml cannot have. Its loop is driven by the skill's own
# claim, so closing the fail-open there needs a list of which skills must carry
# the protocol — and REQUIRED_SKILLS is that list, here.
#
# What this no longer does is re-check that the SECTION exists — ci.yml does that
# on every run, and with the unconditional check above its `|| continue` can no
# longer skip the skill that matters.
#
# The bullet COUNT stays, because ci.yml does not have one. An earlier draft
# removed it claiming ci.yml covered it; ci.yml asserts the section header, the
# version-file paths, the release branch and bin/release, and counts nothing.
# The answer that goes quiet without this is the reviewer's blast-radius list —
# riprap's own extension of merge-gates.md's gated paths — which an emptied
# section turns into "nothing here is gated" with nothing saying so.
#
# The `dropped` flag went, though: it could never change the return value,
# because nothing between its two uses could clear `bad`.
check_stored_answers() {
  local label=$1 file=$2 section=$3 answers=${4:-$ANSWERS} bad=0 n
  grep -qF 'riprap-skills.md' "$file" || {
    echo "❌ $label no longer reads $answers; the stored-answers protocol was dropped"
    echo "   Nothing else looks: ci.yml skips any skill that does not mention the file,"
    echo "   so dropping the protocol makes the check that would catch it go quiet."
    bad=1; }

  [ -f "$answers" ] || { echo "❌ $answers is missing"; return 1; }

  # awk, not `sed -n '/^## x$/,/^## /p'`: the sed range restarts on a second copy
  # of the header, so a merge conflict resolved by keeping both sides counts two
  # answers twice and reports four.
  n=$(awk -v s="## $section" '
    $0 == s && !seen { f = 1; seen = 1; next }
    f && /^## / { f = 0 }
    f && /^- / { c++ }
    END { print c + 0 }' "$answers") || { echo "❌ $answers: awk failed"; return 1; }
  [ "$n" -ge 4 ] || {
    echo "❌ $answers '$section' records $n answers; the skill asks four"
    echo "   A fact left out of the list is dropped by the next rewrite with nothing saying so."
    bad=1; }

  return "$bad"
}

# ---------------------------------------------------------------------------
# --self-test: every assertion, against a fixture built to break it — and
# checked for firing on its OWN reason.
#
# The first version asserted only a non-zero exit. Mutation testing found that
# A4 and A5 could each be deleted in full with the self-test still green, because
# one over-determined fixture tripped every sub-assertion at once and any of them
# satisfied the exit status. Every `fires` case now names the message it expects.
# ---------------------------------------------------------------------------

# A minimal reviewer that passes the contract. Every A4/A5/A6 fixture is this,
# broken in exactly one place, so a failure can only be attributed one way.
good_reviewer() {
  cat <<'EOF'
# Reviewer

Classify per interaction-preferences.md; code-review.md says why a diff is
reviewed at all. Gated paths are in merge-gates.md, and git.md covers what the
diff even is. Simplicity defers to design-principles.md, and the dependency
creep angle to tech-footprint.md.

Five at minimum.
The roster always includes dependency creep.

VERDICT: merge | merge after the blockers below | do not merge

Blockers — BLOCKER and MAJOR, both fixed before this merges.
On a gated path the verdict also carries HOLD: human review required;
hold only a change you would otherwise merge.
A BLOCKER surviving a second pass means open as a draft instead.

Post one review with event: COMMENT.
Carry a Recommended fix on every finding.
If anchoring fails, fall back to a summary-only comment.

Stored answers live in riprap-skills.md.
EOF
}

self_test() {
  local st=0
  # Not local: the EXIT trap fires after this function has returned, and a local
  # is out of scope by then — which under `set -u` aborts the script with
  # "tmp: unbound variable" after every assertion has already passed.
  tmp=$(mktemp -d)
  trap 'rm -rf "$tmp"' EXIT

  # Fires when the assertion rejects its fixture AND says why. Checking the
  # message is what distinguishes "this assertion worked" from "some other
  # assertion in the same function worked" and from "the function crashed".
  fires() {
    local name=$1 expect=$2; shift 2
    local out
    if out=$("$@" 2>&1); then
      echo "❌ self-test: $name did NOT fire on a fixture built to break it"
      st=1; return
    fi
    case "$out" in
      *"$expect"*) echo "   ✓ $name" ;;
      *) echo "❌ self-test: $name failed, but not for its own reason"
         echo "     expected to see: $expect"
         echo "$out" | sed 's/^/     /'
         st=1 ;;
    esac
  }
  passes() {
    local name=$1; shift
    if "$@" >/dev/null 2>&1; then
      echo "   ✓ $name — clean fixture passes"
    else
      echo "❌ self-test: $name fired on a CLEAN fixture"
      "$@" 2>&1 | sed 's/^/     /' || true
      st=1
    fi
  }

  # --- A1 -------------------------------------------------------------------
  echo 'Follow merge-getes.md before merging.' >"$tmp/a1-dangling.md"
  fires "A1 dangling doc mention" "which is not in" \
    check_doc_mentions_resolve fx "$tmp/a1-dangling.md"

  cat >"$tmp/a1-ok.md" <<'EOF'
Classify per interaction-preferences.md, hold per merge-gates.md.
The public list is docs/rules.md; answers live in riprap-skills.md, and
CLAUDE.md points at it. Notes go in .github/releases/v0.5.0.md, or in
.github/releases/<tag>.md where <tag> is the version being cut.
EOF
  passes "A1 paths and non-docs" check_doc_mentions_resolve fx "$tmp/a1-ok.md"
  passes "A1b allowlist is honest" check_allowlist_is_honest

  # --- A2 -------------------------------------------------------------------
  # The paraphrase. No pipe anywhere, so a table blacklist sees nothing; this is
  # a complete second definition, and its MAJOR line inverts code-review.md's
  # "never Ignored".
  cat >"$tmp/a2-caps.md" <<'EOF'
Classify every finding:

- BLOCKER — the change is wrong or unsafe as written.
- MAJOR — a real problem; fix it, or note it and move on.
- MINOR — worth doing, not worth blocking.
- NON-ISSUE — considered and dismissed.
EOF
  fires "A2 unpointed vocabulary" "with no pointer" \
    check_class_vocabulary fx "$tmp/a2-caps.md"

  # The same table in sentence case walked past the first version entirely.
  cat >"$tmp/a2-lower.md" <<'EOF'
Classify each finding:

- Blocker: stop.
- Major: fix it, or note it as a follow-up and merge anyway.
- Minor: style.
- Non-issue: fine.
EOF
  fires "A2 lower-case class table" "any case, with no pointer" \
    check_class_vocabulary fx "$tmp/a2-lower.md"

  cat >"$tmp/a2-wrapped.md" <<'EOF'
Findings come back classified BLOCKER, MAJOR, MINOR and NON-ISSUE, using the
table in interaction-preferences.md rather than a second scheme.
EOF
  passes "A2 hard-wrapped citation" check_class_vocabulary fx "$tmp/a2-wrapped.md"

  printf 'The MAJORITY of reviews are clean.\n' >"$tmp/a2-majority.md"
  passes "A2 MAJORITY is not a class" check_class_vocabulary fx "$tmp/a2-majority.md"

  # A table cited once, from beneath. No caption can sit within two physical
  # lines of both the first and the last row of a three-row table.
  cat >"$tmp/a2-table.md" <<'EOF'
| What is outstanding | Verdict |
|---|---|
| a BLOCKER | do not merge |
| a MAJOR, and no BLOCKER | merge after the blockers below |
| nothing above MINOR | merge |

The classes are interaction-preferences.md's.
EOF
  passes "A2 table cited from beneath" check_class_vocabulary fx "$tmp/a2-table.md"

  # And the table must not become a hole: uncited, it is still a fork.
  cat >"$tmp/a2-table-bad.md" <<'EOF'
| Class | What to do |
|---|---|
| a BLOCKER | stop |
| a MAJOR | note it as a follow-up |
| a MINOR | ignore |
EOF
  fires "A2 uncited table" "with no pointer" \
    check_class_vocabulary fx "$tmp/a2-table-bad.md"

  # --- A3 -------------------------------------------------------------------
  # An interaction-preferences.md row, deliberately. code-review.md's rows are no
  # longer forbidden — they moved into the reviewer skill, which owns them now —
  # so a fixture built from one would assert the opposite of the current rule and
  # pass for the wrong reason. A9 covers that direction.
  printf '%s\n' "Classify it:" "| Class | Meaning | Effect on the plan |" >"$tmp/a3-pasted.md"
  fires "A3 pasted table header" "pastes a table" \
    check_no_pasted_tables fx "$tmp/a3-pasted.md"

  printf 'Classify per interaction-preferences.md rather than restating it.\n' >"$tmp/a3-ok.md"
  passes "A3 citation only" check_no_pasted_tables fx "$tmp/a3-ok.md"

  # --- A8 -------------------------------------------------------------------
  printf 'Review it. Use your judgement.\n' >"$tmp/a8-none.md"
  fires "A8 defers to nothing" "never names code-review.md" \
    check_defers_to fx "$tmp/a8-none.md"
  good_reviewer >"$tmp/good.md"
  passes "A8 names every owning document" check_defers_to fx "$tmp/good.md"

  good_reviewer | sed 's/ and the dependency$//;s/^creep angle to tech-footprint.md.$//' >"$tmp/a8-notech.md"
  fires "A8 dependency angle with no owning document" "never names tech-footprint.md" \
    check_defers_to fx "$tmp/a8-notech.md"

  # --- A9 -------------------------------------------------------------------
  # The real tree, both directions at once: every moved row is in the skill and
  # in neither guardrail document. Running this against the repo rather than a
  # fixture is the point — A9 exists to catch a half-finished move, and only the
  # real files can be half-finished.
  passes "A3/A9 rows have exactly one owner" \
    check_moved_out reviewer plugin/skills/reviewer/SKILL.md

  # A skill that never received them: the move was announced and not made.
  printf 'Review it, then post a comment.\n' >"$tmp/a9-missing.md"
  fires "A9 owner never received the moved rows" "It owns that row" \
    check_moved_out fx "$tmp/a9-missing.md"

  # And the half this commit exists for: the document KEPT a row that moved.
  # Vacuous against the real tree — code-review.md holds none of them now — so
  # without this fixture the branch could be deleted with everything still green.
  mkdir -p "$tmp/docs"
  { echo '# stale copy'; code_review_rows; } >"$tmp/docs/code-review.md"
  fires "A9 document kept a row that moved" "kept a row that moved into the skill" \
    check_moved_out reviewer plugin/skills/reviewer/SKILL.md "$tmp/docs/code-review.md"

  # --- A4/A5/A6, one fixture per sub-assertion ------------------------------
  passes "A4-A6 canonical reviewer" check_reviewer_contract fx "$tmp/good.md"

  good_reviewer | sed 's/^VERDICT:/    VERDICT:/' >"$tmp/a4-indented.md"
  fires "A4 verdict indented out of column 0" "expected exactly 1" \
    check_reviewer_contract fx "$tmp/a4-indented.md"

  # The verdict present only inside a "never write this" fence, with the real
  # instruction a different menu at column 0. The first version counted 1 and
  # passed this.
  { good_reviewer | sed 's/^VERDICT: merge.*/```\nVERDICT: merge | merge after the blockers below | do not merge\n```\nVERDICT: approve | probably fine | unsure/'; } >"$tmp/a4-fenced.md"
  fires "A4 canonical menu only inside a fence" "not the canonical menu" \
    check_reviewer_contract fx "$tmp/a4-fenced.md"

  # The list is pinned here, independently, BEFORE anything is generated from it.
  #
  # Generating the fixtures from verdict_rules() fixed "add a rule, forget its
  # fixture" and introduced its mirror: delete a rule and you delete its own
  # test, so the mutation self-cancels and --self-test still prints "every
  # assertion fires on its own fixture". Verified: removing `event: COMMENT` from
  # the list left both modes green and a reviewer skill that never names the safe
  # review event passing clean — and A5 is the only assertion requiring it, since
  # A6 only forbids the two unsafe ones.
  #
  # So the count and the membership are asserted against literals. Removing a
  # rule now means editing this block too, which puts the intent in the diff
  # where a human sees it.
  n=$(verdict_rules | grep -c .)
  [ "$n" -eq 9 ] || {
    echo "❌ self-test: verdict_rules() lists $n rules, expected 9"
    echo "   Adding one? Update the number here. Removing one? Say why in the diff."
    st=1; }
  for want in 'BLOCKER and MAJOR' 'HOLD: human review required' \
              'hold only a change you would otherwise merge' 'open as a draft' \
              'event: COMMENT' 'Recommended fix' 'summary-only' \
              'Five at minimum' 'dependency creep'; do
    verdict_rules | grep -qxF -- "$want" || {
      echo "❌ self-test: verdict_rules() no longer requires: $want"; st=1; }
  done

  # One generated fixture per rule, each the clean reviewer with exactly that
  # phrase removed — so a failure can only be attributed one way, and a rule
  # added to the list gets its fixture for free. good_reviewer() keeps each
  # required phrase on its own line so `grep -vF` takes no line-mate with it;
  # two pairs shared a line and produced byte-identical fixtures.
  while IFS= read -r rule; do
    [ -n "$rule" ] || continue
    grep -vF -- "$rule" <(good_reviewer) >"$tmp/a5-missing.md"
    fires "A5 dropped: $rule" "no longer contains the required phrase: $rule" \
      check_reviewer_contract fx "$tmp/a5-missing.md"
  done < <(verdict_rules)

  # The other branch of A5, which no generated fixture reaches: the phrase is
  # present but only ever inside a prohibition. Kept by hand because it is a
  # different code path, not a different rule.
  good_reviewer | sed 's/^hold only a change.*/hold only a change you would otherwise merge./;s/^On a gated path.*/Never write HOLD: human review required./' >"$tmp/a5-neg.md"
  fires "A5 HOLD stated only as a prohibition" "only ever mentions" \
    check_reviewer_contract fx "$tmp/a5-neg.md"

  # --- A6, now standalone and run over every skill --------------------------
  passes "A6 clean reviewer" check_never_merges fx "$tmp/good.md"

  a6() {  # $1 name, $2 line appended to the clean reviewer
    printf '%s\n' "$2" >"$tmp/a6.md"
    fires "A6 $1" "instructs a merge or an approval" check_never_merges fx "$tmp/a6.md"
  }
  a6 "bare merge"            'Then run gh pr merge --squash.'
  a6 "merge via gh api"      'Then gh api -X PUT "repos/$O/$R/pulls/$N/merge" -f merge_method=squash.'
  a6 "approval language"     'Leave a comment reading LGTM.'
  # The four that were verified as clean passes before this commit.
  a6 "approve with an argument"    'Then run gh pr review "$N" --approve --body "no blockers remain".'
  a6 "event=APPROVE via a jq var"  'jq -n --arg ev APPROVE "{event: \$ev}" | gh api ".../pulls/$N/reviews" --input -'
  a6 "negation before, instruction after" \
    '**Never leave a green pull request sitting.** Run `gh pr merge "$N" --squash --admin`. Do not stop short.'

  # And the legitimate case, which a whole-line negation test got right and must
  # keep getting right: the prohibition comes BEFORE the command it names.
  { good_reviewer; echo 'Never run gh pr merge, and never bypass with --admin.'; } >"$tmp/a6-forbids.md"
  passes "A6 skill forbidding the act" check_never_merges fx "$tmp/a6-forbids.md"

  # A skill that is not the reviewer. The main loop ran only A1-A3 over these, so
  # a second skill approving and force-merging scored "✅ 7 skills" and exit 0.
  printf '# PR lander\nRun gh pr merge "$N" --squash --admin, then post LGTM.\n' >"$tmp/a6-other.md"
  fires "A6 a non-reviewer skill instructs a merge" "instructs a merge or an approval" \
    check_never_merges pr-lander "$tmp/a6-other.md"

  # The editing half, which lives in check_reviewer_contract because it is this
  # skill's rule alone. `git -C` is the form an agent outside the worktree uses,
  # and it walked past the bare-verb list.
  { good_reviewer; echo 'Commit the fix yourself with git commit.'; } >"$tmp/a6-edit.md"
  fires "A6 skill edits the branch" "edits a branch it is only supposed to report on" \
    check_never_edits fx "$tmp/a6-edit.md"

  { good_reviewer; echo 'Fix it with git -C "$REPO" commit --amend --no-edit.'; } >"$tmp/a6-editc.md"
  fires "A6 edit via git -C" "edits a branch it is only supposed to report on" \
    check_never_edits fx "$tmp/a6-editc.md"

  printf 'Apply the fix yourself with the Edit tool.\n' >"$tmp/a6-editt.md"
  fires "A6 edit via the Edit tool" "edits a branch it is only supposed to report on" \
    check_never_edits fx "$tmp/a6-editt.md"

  passes "A6 clean reviewer makes no edits" check_never_edits fx "$tmp/good.md"

  # --- A7 -------------------------------------------------------------------
  # Only the unconditional half remains, so only it needs a fixture. The section
  # and bullet-count cases went with the assertions they covered, which ci.yml
  # makes on every run.
  cat >"$tmp/answers-ok.md" <<'EOF'
## riprap:reviewer

- Base branch: `main`
- Forge: `gh`
- Where a review lands: a pull request comment
- Extra blast-radius paths: none
EOF
  printf 'Read the stored answers in riprap-skills.md first.\n' >"$tmp/a7-ok.md"
  passes "A7 protocol present" \
    check_stored_answers fx "$tmp/a7-ok.md" riprap:reviewer "$tmp/answers-ok.md"

  printf 'Work the answers out fresh each run.\n' >"$tmp/a7-dropped.md"
  fires "A7 stored-answers protocol dropped" "the stored-answers protocol was dropped" \
    check_stored_answers fx "$tmp/a7-dropped.md" riprap:reviewer "$tmp/answers-ok.md"

  # Two copies of the header, four bullets between them — the shape a merge
  # conflict resolved by keeping both sides produces. A sed range counts four.
  cat >"$tmp/answers-dup.md" <<'EOF'
## riprap:reviewer

- Base branch: `main`
- Forge: `gh`

## other

## riprap:reviewer

- Where a review lands: a comment
- Extra blast-radius paths: none
EOF
  fires "A7 duplicated section counted once" "records 2 answers" \
    check_stored_answers fx "$tmp/a7-ok.md" riprap:reviewer "$tmp/answers-dup.md"

  echo
  if [ "$st" -eq 0 ]; then
    echo "✅ self-test passed: every assertion fires on its own fixture, for its own reason"
  fi
  return "$st"
}

# ---------------------------------------------------------------------------

if [ "${1:-}" = "--self-test" ]; then
  self_test
  exit $?
fi

fail=0
count=0

check_allowlist_is_honest || fail=1

# Counted from the loop itself, not from a separate `find`. The two enumerate
# different sets — find does not follow symlinks and the trailing-slash glob
# does — so a guard counting one while the loop iterates the other cannot
# establish what it claims to.
for d in plugin/skills/*/; do
  name=$(basename "$d")
  f="$d/SKILL.md"
  [ "$name" = "*" ] && break            # the glob matched nothing
  [ -f "$f" ] || { echo "❌ $name has no SKILL.md"; fail=1; continue; }
  [ -s "$f" ] || { echo "❌ $name/SKILL.md is empty"; fail=1; continue; }
  [ -r "$f" ] || { echo "❌ $name/SKILL.md is not readable"; fail=1; continue; }
  count=$((count + 1))

  # Every markdown file the skill directory carries, not just SKILL.md. Bundled
  # reference files are the standard skill layout, and they were invisible to all
  # nine assertions: a plugin/skills/reviewer/references/procedure.md holding a
  # pasted class table AND `gh pr merge --admin` AND `LGTM` scored a clean pass,
  # defeating A2, A3 and A6 at once.
  # find, not a glob pair: bash 3.2 has no globstar, and the two-level glob it
  # forced left references/sub/procedure.md unscanned — verified as a clean pass
  # carrying a merge instruction. CI permits any depth under plugin/skills/, so
  # "the levels a skill actually uses" was a convention with no enforcer.
  #
  # -L because the glob DID follow a symlinked directory and bare find does not.
  # Verified: a references/ symlinked to a directory holding a force-merge
  # instruction was scanned by the glob and silently skipped by bare find, which
  # would have made the depth fix a net loss. -type f resolves through the link
  # and keeps a symlink loop from being walked as a directory.
  while IFS= read -r extra; do
    [ -f "$extra" ] || continue
    check_doc_mentions_resolve "$name" "$extra" || fail=1
    check_class_vocabulary     "$name" "$extra" || fail=1
    check_no_pasted_tables     "$name" "$extra" || fail=1
    check_never_merges         "$name" "$extra" || fail=1
    case " $REQUIRED_SKILLS " in *" $name "*)
      check_never_edits        "$name" "$extra" || fail=1 ;;
    esac
  done < <(find -L "$d" -name '*.md' -type f)
done

[ "$count" -ge 1 ] || { echo "❌ plugin/skills/ contains no skills"; exit 1; }

# A skill that must exist, checked before its contract, so a rename or a bad
# merge reds this file instead of silently retiring every assertion below.
for name in $REQUIRED_SKILLS; do
  [ -f "plugin/skills/$name/SKILL.md" ] || {
    echo "❌ plugin/skills/$name/SKILL.md is missing; its contract is unenforced"
    fail=1; continue; }
  check_defers_to         "$name" "plugin/skills/$name/SKILL.md" || fail=1
  check_reviewer_contract "$name" "plugin/skills/$name/SKILL.md" || fail=1
  check_stored_answers    "$name" "plugin/skills/$name/SKILL.md" "riprap:$name" || fail=1
  check_moved_out         "$name" "plugin/skills/$name/SKILL.md" || fail=1
done

if [ "$fail" -eq 0 ]; then
  # Deliberately narrow. The claim a reader takes away is the one printed here,
  # not the header comment, so it says what actually ran.
  echo "✅ $count skills: every .md they name resolves, the class vocabulary carries a"
  echo "   pointer, no header row a guardrail still owns is pasted, and what moved into"
  echo "   the reviewer is gone from the document it left, and no skill instructs a"
  echo "   merge or an approval. Prose that restates a rule in its own words is not"
  echo "   detectable here — see the header."
fi
exit "$fail"
