#!/usr/bin/env bash
# refresh-style-guide — regenerate the write skill's reference material from upstream.
#
# plugin/skills/write/reference/ is a distillation of the Google developer
# documentation style guide, which is a living document. A copy taken once and
# never refreshed drifts silently: it keeps answering questions with guidance the
# source has since changed, and nothing looks broken. So the copy is generated,
# and this script is the generator.
#
# Extraction, not authorship. Everything under reference/ is upstream prose
# reduced to text, so a refresh is a re-fetch and a diff a human can read. The
# hand-written half of the standard lives in plugin/instructions/writing-style.md
# and in the skill's own SKILL.md — those are riprap's words and this script never
# touches them. That split is the whole reason lockstep is possible: you cannot
# regenerate a distillation somebody wrote.
#
#   bin/refresh-style-guide          re-fetch and rewrite reference/ (needs network)
#   bin/refresh-style-guide --check  validate what is committed, offline (for CI)
#
# --check deliberately makes no network call. Wiring an external site into the
# main build means a Google outage or redesign turns a pull request red for
# reasons its author cannot fix. Upstream drift is found by the scheduled
# workflow in .github/workflows/refresh-style-guide.yml, which runs the real
# refresh and opens a pull request when the diff is non-empty.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

BASE="https://developers.google.com/style"
OUT="plugin/skills/write/reference"

# Which upstream pages land in which reference file, grouped by the question a
# reader is asking. One file per group rather than one per page: seventy files
# would make the skill's own index the hardest thing in it to read.
#
# whats-new is deliberately absent. It is a changelog of the guide itself, not
# guidance, and it is the single largest page upstream.
GROUP_NAMES=(voice-and-tone structure mechanics code-and-ui word-list)

group_pages() {
  case "$1" in
    voice-and-tone) echo "highlights philosophy voice tone person tense contractions
      anthropomorphism excessive-claims jargon pronouns future timeless-documentation
      prescriptive-documentation inclusive-documentation accessibility translation" ;;
    structure) echo "sentence-structure paragraph-structure headings headings-targets
      lists tables procedures notices cross-references footnotes examples format-examples
      other-sources" ;;
    mechanics) echo "capitalization text-formatting abbreviations articles prepositions
      pluralization possessives spelling numbers dates-times units-of-measure phone-numbers
      mathematical-notation italics-terms commas colons semicolons periods dashes hyphens
      ellipses parentheses quotation-marks slashes" ;;
    code-and-ui) echo "code-in-text code-samples code-syntax placeholders filenames
      ui-elements images api-reference-comments reference-verbs product-names trademarks
      semantic-tagging html-formatting markdown" ;;
    word-list) echo "word-list" ;;
  esac
}

group_title() {
  case "$1" in
    voice-and-tone) echo "Voice, tone, and language" ;;
    structure)      echo "Document structure" ;;
    mechanics)      echo "Capitalization, punctuation, and mechanics" ;;
    code-and-ui)    echo "Code, UI, and reference material" ;;
    word-list)      echo "Word list" ;;
  esac
}

# The provenance block every generated file opens with. A reader who lands in one
# of these has to be able to tell, without leaving the file, that it is upstream
# text rather than riprap's opinion, and where the original lives.
provenance() {  # $1 = group, $2 = page count
  cat <<EOF
<!-- GENERATED by bin/refresh-style-guide. Do not edit by hand: the next refresh
     overwrites this file. Change the generator, or the hand-written standard in
     plugin/instructions/writing-style.md. -->

# $(group_title "$1")

Extracted from the [Google developer documentation style guide]($BASE),
used under [CC BY 4.0](https://creativecommons.org/licenses/by/4.0/).
Google is not affiliated with riprap and does not endorse it.

This file is **upstream text reduced to plain text**, not riprap's guidance.
It covers $2 source pages. Where it and riprap disagree, riprap's own
[writing-style.md](../../../instructions/writing-style.md) wins — and where a
project disagrees with either, the project wins.

EOF
}

# HTML to text, in the only shape that survives a page whose markup changes:
# flatten to one line, cut to the article body, then re-introduce newlines at the
# block boundaries that carry meaning. A parser that depends on indentation or on
# tags appearing on their own line breaks the first time upstream reflows.
to_text() {
  tr '\n' ' ' \
  | sed -e 's/<script[^>]*>[^<]*<\/script>/ /g' \
        -e 's/<style[^>]*>[^<]*<\/style>/ /g' \
  | sed -e 's/.*<div[^>]*devsite-article-body[^>]*>//' \
        -e 's/<devsite-content-footer.*//' \
        -e 's/<\/article>.*//' \
  | sed -e 's/<span class="material-icons"[^>]*>link<\/span>//g' \
  | sed -e 's/<h[1-6][^>]*>/\n\n#### /g' \
        -e 's/<\/h[1-6]>/\n/g' \
        -e 's/<li[^>]*>/\n- /g' \
        -e 's/<dt[^>]*>/\n\n- /g' \
        -e 's/<dd[^>]*>/\n  /g' \
        -e 's/<\/p>/\n\n/g' \
        -e 's/<\/tr>/\n/g' \
        -e 's/<\/t[dh]>/ | /g' \
        -e 's/<br[^>]*>/\n/g' \
  | sed -e 's/<[^>]*>//g' \
  | sed -e 's/&nbsp;/ /g' -e 's/&lt;/</g' -e 's/&gt;/>/g' \
        -e 's/&quot;/"/g' -e "s/&#39;/'/g" -e 's/&amp;/\&/g' \
  | sed -e 's/[[:space:]]\{2,\}/ /g' -e 's/^ //' -e 's/ $//' \
  | sed -e 's/ Send feedback$//' -e 's/ *outlined_flag//' \
  | grep -v '^$' \
  | grep -vx 'Send feedback'
}

fetch_page() {  # $1 = page slug
  curl -fsS --max-time 60 --retry 2 "$BASE/$1"
}

# --- --check: offline validation -------------------------------------------
if [ "${1:-}" = "--check" ]; then
  fail=0
  for g in "${GROUP_NAMES[@]}"; do
    f="$OUT/$g.md"
    [ -s "$f" ] || { echo "❌ $f is missing or empty — run bin/refresh-style-guide"; fail=1; continue; }
    grep -q 'GENERATED by bin/refresh-style-guide' "$f" || {
      echo "❌ $f lost its generated-file banner; it may have been hand-edited"; fail=1; }
    grep -q 'CC BY 4.0' "$f" || {
      echo "❌ $f carries no licence attribution, which the source requires"; fail=1; }
    # Every page the generator claims to cover has to have left a heading behind.
    # Without this the check passes on a file truncated by a failed fetch.
    for p in $(group_pages "$g"); do
      grep -q "^## $p\$" "$f" || {
        echo "❌ $f does not contain the '$p' section"; fail=1; }
    done
  done
  [ "$fail" -eq 0 ] || exit 1
  echo "✅ style-guide reference is present, attributed, and complete"
  exit 0
fi

# --- regenerate -------------------------------------------------------------
command -v curl > /dev/null || { echo "refresh-style-guide: needs curl" >&2; exit 1; }

mkdir -p "$OUT"
tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT

total=0
for g in "${GROUP_NAMES[@]}"; do
  pages=$(group_pages "$g")
  count=$(echo $pages | wc -w | tr -d ' ')
  echo "  $g ($count pages)"
  provenance "$g" "$count" > "$tmp/$g.md"
  for p in $pages; do
    printf '## %s\n\n' "$p" >> "$tmp/$g.md"
    printf 'Source: %s/%s\n\n' "$BASE" "$p" >> "$tmp/$g.md"
    if ! fetch_page "$p" | to_text >> "$tmp/$g.md"; then
      echo "❌ could not fetch $BASE/$p" >&2
      exit 1
    fi
    printf '\n' >> "$tmp/$g.md"
    total=$((total + 1))
  done
  mv "$tmp/$g.md" "$OUT/$g.md"
done

echo "✅ refreshed $total pages into $OUT/"
echo "   Review the diff: these are upstream words, and a surprising change there"
echo "   is a change to the standard riprap ships, not a formatting nit."
