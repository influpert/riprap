#!/usr/bin/env bash
# release — set the shipped version in all manifests, commit it, and tag the commit that merged.
#
# The version lives in three manifests and the tag is a fourth value. All four have to agree:
# .github/workflows/release.yml refuses to publish a tag whose tree claims a
# different version, because a v0.5.0 release built from a tree still saying 0.4.0
# installs as 0.4.0 in every adopting repository, and the release page is the only
# place that discrepancy is visible. Doing it by hand means three edits in three
# formats, and the one that gets missed is silent until someone installs it.
#
#   bin/release 0.5.0 --start  draft the notes, branch, bump, push, open the PR
#   bin/release 0.5.0 --finish once it has merged: tag, push, watch, verify
#
#   bin/release 0.5.0          the long form: bump both files and commit — no tag
#   bin/release 0.5.0          again, on the merged commit: tag it, push nothing
#   bin/release --verify       every v* tag on origin has a release behind it
#   bin/release --verify 0.5.0 that one release is published, and correct
#   bin/release --changelog    regenerate CHANGELOG.md from .github/releases/*.md
#   bin/release --changelog --check  exit 1 if CHANGELOG.md is out of date (for CI)
#
# --start regenerates CHANGELOG.md itself, alongside the notes it drafts or the notes
# you already wrote by hand — both land in the same commit. The long form does not draft
# or commit notes at all, so on that path run --changelog yourself before opening the
# pull request. Either way `bin/test` runs `--changelog --check` on every push, so a
# NOTES file edited after that commit without a matching regeneration fails the pull
# request rather than shipping a changelog that quietly stopped matching what merged.
#
# --check ignores date-only differences on purpose. A version's date can only be
# resolved once its tag exists, which is after --finish — and nothing can push a
# refresh commit straight to main afterwards (branch protection requires a pull
# request for every change, admins included). So a freshly-tagged entry ships
# dateless and self-heals the next time --changelog runs with that tag visible,
# typically the following release's --start; --check would otherwise start failing
# on the very next unrelated pull request the moment CI can see the new tag.
#
# Two runs, and the split is the point. The version files sit under CODEOWNERS-gated
# directories, so the bump merges as a pull request; a tag cut before that merges
# points at a commit the squash-merge discards. The first run therefore makes no tag
# at all — there is nothing to delete — and the second refuses unless HEAD is
# contained in the default branch.
#
# What pushes, and what does not. The long form never pushes at all: its tag stays
# local and deletable. --start pushes a branch, which is reversible. --finish pushes
# the TAG, and that publishes a release that cannot be un-published — so --finish is
# the publishing command, and it is meant to be typed deliberately, having read the
# checks it prints first. It refuses without gh, and refuses on a red or unknown CI
# status it cannot ask a human about, because those are the questions it exists to
# answer and it may not act on "could not tell".
#
# Exit 0 = fine, 1 = refused or findings, 2 = usage error.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

PLUGIN_JSON="plugin/.claude-plugin/plugin.json"
CODEX_JSON="plugin/.codex-plugin/plugin.json"
CODEX_PRE_NATIVE_TAGS="plugin/.codex-plugin/pre-native-tags"
MARKET_JSON=".claude-plugin/marketplace.json"
NOTES_DIR=".github/releases"
CHANGELOG_FILE="CHANGELOG.md"

# Written into a drafted notes file, and refused on the tag path while it is still
# there. Deleting one line is the smallest act that proves a person opened the file —
# and the workflow publishes that file verbatim, so without this the whole pipeline
# could report green on a release body reading "TODO: rewrite this".
DRAFT_SENTINEL="<!-- riprap: generated draft. Delete this line once the body is written. -->"

usage() {
  cat >&2 <<'USAGE'
bin/release <x.y.z>          bump all version files and commit; run again on the
                             merged commit to tag it
bin/release <x.y.z> --start  draft the notes, branch, bump, push, open the pull
                             request — everything up to the merge
bin/release <x.y.z> --finish tag the merged commit, push it, watch the publish,
                             and verify — everything after
bin/release --verify         report every v* tag on origin with no release behind it
bin/release --verify <x.y.z> check one release: tag, release, versions, body
bin/release --changelog      regenerate CHANGELOG.md from .github/releases/*.md
bin/release --changelog --check   exit 1 if CHANGELOG.md is out of date (for CI)

Write .github/releases/v<x.y.z>.md first — the release workflow publishes that
file as the body and refuses without it. --start drafts it for you to edit, and
regenerates CHANGELOG.md alongside it in the same commit. The long form does
neither — on that path, run --changelog yourself before opening the pull request.

The two gates are unchanged either way: a human merges the pull request, and a
human types the command that pushes the tag.
USAGE
  exit 2
}

# ── shared helpers ───────────────────────────────────────────────────────────

# Exactly one "version" key per file, or the substitution below is editing
# something it was not aimed at. Checked rather than assumed, because a sed that
# rewrites the wrong key produces valid JSON and a wrong release.
version_in() {
  local file="$1" count
  # Occurrences, not matching lines. grep -c counts lines, so a minified file with two
  # version keys on one line reads as one — and then version_in's greedy match returns
  # the last while set_version's sed rewrites the first.
  count="$(grep -o '"version"' "$file" | wc -l | tr -d ' ')"
  if [ "$count" -ne 1 ]; then
    echo "❌ $file has $count \"version\" keys, expected 1. Fix by hand." >&2
    exit 1
  fi
  sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$file"
}

set_version() {
  local file="$1" want="$2"
  # -i.bak then remove: BSD sed requires an argument to -i, GNU sed accepts one.
  sed -i.bak -E "s/(\"version\"[[:space:]]*:[[:space:]]*\")[^\"]*(\")/\1$want\2/" "$file"
  rm -f "$file.bak"
  local got
  got="$(version_in "$file")"
  if [ "$got" != "$want" ]; then
    echo "❌ $file still says $got after the edit. Nothing committed." >&2
    exit 1
  fi
}

# No leading zeros. 0.05.0 passes a naive digits-only check and is not semver: it
# installs as a string no adopter's tooling equates with 0.5.0, and `sort -V` places it
# above 0.4.0 — so one typo also blocks every later 0.x release behind a refusal that
# reads like a bug in this script.
is_version() { printf '%s' "$1" | grep -qE '^(0|[1-9][0-9]*)(\.(0|[1-9][0-9]*)){2}$'; }

# Strictly greater, version-ordered. `sort -V` alone cannot answer this — it puts
# equal inputs in an arbitrary order — so equality is ruled out first.
is_greater() {
  [ "$1" != "$2" ] && [ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | tail -1)" = "$1" ]
}

# Tags are read from origin, never from the local ref cache. A local tag that has
# diverged from the remote is not corrected by a plain `git fetch --tags`, which
# declines to move an existing ref without --force — so the local cache is the one
# source that can be confidently stale, and it is the source every check here would
# otherwise trust. Returns 1 when origin could not be reached; the caller decides
# whether that is fatal.
#
# [0-9][0-9]* rather than [0-9]+: \+ is a GNU sed extension and this runs on BSD too.
remote_versions() {
  local out
  if out="$(git ls-remote --refs --tags origin 2>/dev/null)"; then
    printf '%s\n' "$out" |
      sed -n 's|.*refs/tags/v\([0-9][0-9]*\.[0-9][0-9]*\.[0-9][0-9]*\)$|\1|p' | sort -V
    return 0
  fi

  # Then gh, which reaches the forge over HTTPS with its own credential. The two fail
  # independently and for unrelated reasons: an SSH remote in an environment with no
  # key fails every `git ls-remote` while gh answers fine, and a lapsed gh token fails
  # every API call while ssh works. Observed, not theoretical — cutting 0.6.0 in an
  # agent session hit exactly the first case, and the fallback of the day was the local
  # tag cache, which is the one source that can be silently stale.
  have_gh || return 1
  local slug; slug="$(repo_slug)"
  [ -n "$slug" ] || return 1
  out="$(gh api --paginate "repos/$slug/tags" --jq '.[].name' 2>/dev/null)" || return 1
  printf '%s\n' "$out" |
    sed -n 's|^v\([0-9][0-9]*\.[0-9][0-9]*\.[0-9][0-9]*\)$|\1|p' | sort -V
}

# Ask origin first. refs/remotes/origin/HEAD is not set by `git remote add`, and not by
# a CI checkout either, so the local symref is absent far more often than it looks —
# and guessing "main" in a repository whose default is "master" does not fail loudly.
# It makes every later fetch of that branch fail, which used to mean the ancestor check
# was skipped with a warning on every single release, permanently.
default_branch() {
  local ref
  ref="$(git ls-remote --symref origin HEAD 2>/dev/null |
    sed -n 's|^ref:[[:space:]]*refs/heads/\([^[:space:]]*\).*|\1|p' | head -1)"
  [ -n "$ref" ] && { printf '%s' "$ref"; return; }
  if ref="$(git symbolic-ref -q --short refs/remotes/origin/HEAD 2>/dev/null)"; then
    printf '%s' "${ref#origin/}"
    return
  fi
  printf 'main'
}

have_gh() { command -v gh >/dev/null 2>&1; }

# The owner/repo gh should ask about, resolved from ORIGIN specifically.
#
# `gh api repos/{owner}/{repo}` does NOT mean origin: gh ranks an `upstream` remote
# above it, and $GH_REPO overrides both. On a fork that silently asks a different
# repository — and the answers feed the two checks that cannot be undone, so a tag
# list from the wrong repo can wave through re-cutting a published version.
repo_slug() {
  local url
  url="$(git remote get-url origin 2>/dev/null)" || return 1
  # Strip .git BEFORE matching. Doing it as a second sed expression printed the slug
  # twice, once with the suffix and once without, and head -1 then took the wrong one.
  url="${url%.git}"
  printf '%s' "$url" | sed -n 's|.*github\.com[:/]\([^/]*/[^/]*\)$|\1|p'
}

# ── --start: draft the notes ─────────────────────────────────────────────────

# A scaffold, never a finished body. It lists what merged since the previous tag and
# leaves the prose to a person, because the one thing notes are for — telling a reader
# whether to upgrade — is the one thing this cannot generate. What it removes is the
# blank page and the trip to the pull request list, which is where the time actually
# went.
#
# Left deliberately obvious that it is unfinished: the TODO line at the top is what a
# reviewer sees if it ships unedited, and it is easier to notice than a plausible
# machine-written paragraph would be.
draft_notes() {
  local out="$1" prev prev_date
  mkdir -p "$NOTES_DIR"

  prev="$(printf '%s\n' "$REMOTE_VERSIONS" | tail -1)"
  prev_date=""
  if [ -n "$prev" ] && have_gh; then
    prev_date="$(gh api "repos/{owner}/{repo}/releases/tags/v$prev" --jq .published_at 2>/dev/null || true)"
  fi

  {
    echo "$DRAFT_SENTINEL"
    echo "TODO: rewrite this. Every line below is a pull request title, which is what the"
    echo "author called the change — not what a reader needs to decide whether to upgrade."
    echo
    if [ -n "$prev" ]; then
      echo "Merged since v$prev:"
    else
      echo "Merged:"
    fi
    echo
    if have_gh && [ -n "$prev_date" ]; then
      # `gh --jq` takes ONE filter and no --arg; passing one makes gh reject the
      # whole command ("unknown arguments"), which 2>/dev/null then hides. Verified:
      # the first draft of this shipped that mistake and every notes file it wrote
      # was the apology below. Raw JSON into real jq instead, which does take --arg.
      gh pr list --state merged --limit 100 --json number,title,mergedAt 2>/dev/null |
        jq -r --arg d "$prev_date" '.[] | select(.mergedAt > $d) | "- \(.title) (#\(.number))"' 2>/dev/null ||
        git log --oneline "v$prev..HEAD" 2>/dev/null | sed 's/^[0-9a-f]* /- /' ||
        echo "- (could not read what merged; fill this in by hand)"
    elif [ -n "$prev" ]; then
      # No gh, or no release object behind the previous tag. The commit log between the
      # tags is the honest fallback: it names what the branch gained, which is the same
      # question the pull request list answers less noisily.
      git log --oneline "v$prev..HEAD" 2>/dev/null | sed 's/^[0-9a-f]* /- /' ||
        echo "- (could not read the log; fill this in by hand)"
    else
      echo "- (no previous tag to diff against; fill this in by hand)"
    fi
  } >"$out"

  echo "📝 drafted $out from what merged. Edit it before this merges —"
  echo "   the workflow publishes it verbatim as the release body."
}

# ── --changelog: regenerate CHANGELOG.md from the release notes ─────────────

# The heading a version's section opens with, dated or not — shared by the writer
# below and by the two guards in changelog_body() that refuse to let anything else
# on the page take this shape.
CHANGELOG_HEADING_RE='^## v[0-9]+\.[0-9]+\.[0-9]+( — 20[0-9]{2}-[0-9]{2}-[0-9]{2})?$'

# One entry's body: the tagline and $DRAFT_SENTINEL stripped by exact line match, never
# by position. A note still carrying the sentinel — mid --start, before a human has
# touched it — has neither a tagline as line 1 nor an **Install** heading, and a strip
# that assumes either would corrupt it instead of passing it through unchanged.
#
# Truncated at **Install**: that section and the licence line after it are identical in
# every note and belong to README.md, not to a file whose whole job is already "what
# changed". `sed -n '/pat/q;p'` prints everything up to but not including the match,
# using only `q`, which is POSIX and needs no GNU extension to work on both platforms
# this script already promises to run on.
#
# The line every release note opens with — stripped here, not carried into
# CHANGELOG.md, where it would repeat once per entry.
CHANGELOG_TAGLINE="Guardrails for Claude Code, enforced rather than suggested."

# Two ways a body can go wrong that --check cannot catch on its own, because both
# would be wrong the same way on every future run — self-consistent, and self-consistency
# is all a diff against the last regeneration can see.
changelog_body() {
  local file="$1" body

  # A finished note (no sentinel) with nothing matching **Install** exactly would
  # otherwise pass its whole remainder through untruncated — the install steps, the
  # licence line, everything after — into a generated file whose one job is "what
  # changed". A typo as small as a trailing colon defeats the truncation below in
  # total silence; refuse instead of leaking it.
  if ! grep -qF "$DRAFT_SENTINEL" "$file" && ! grep -qFx '**Install**' "$file"; then
    echo "❌ $file has no line matching exactly '**Install**' to truncate at." >&2
    echo "   Left as is, changelog_body would leak everything after the body —" >&2
    echo "   install steps, licence line — into CHANGELOG.md. Fix the heading." >&2
    exit 1
  fi

  body="$(grep -Fxv -e "$CHANGELOG_TAGLINE" -e "$DRAFT_SENTINEL" "$file" |
    sed -n '/^\*\*Install\*\*$/q;p' | sed '/./,$!d' || true)"

  # bin/scrub-check exempts a line shaped like a generated heading on the strength
  # of that shape alone — it has no way to tell this script's own output from a
  # hand-typed line borrowing its cover. A body containing one would ride straight
  # through that exemption regardless of what date it actually names, so this is
  # the one place that can still refuse it: after the strips above (so the real
  # heading this same shape describes, written by the caller, is never in $body to
  # begin with) and before the value ever reaches CHANGELOG.md.
  if printf '%s\n' "$body" | grep -qE "$CHANGELOG_HEADING_RE"; then
    echo "❌ $file's body contains a line shaped like a generated CHANGELOG.md heading" >&2
    echo "   (## vX.Y.Z, optionally dated). Rewrite it — bin/scrub-check's changelog" >&2
    echo "   exemption is anchored to this exact shape and would wave it through." >&2
    exit 1
  fi

  printf '%s\n' "$body"
}

# Regenerated, never hand-edited: every section comes straight from the file that is
# also that release's published GitHub body, so there is exactly one place to write a
# correction. `--check` is what makes that promise mean something — wired into
# bin/test, which runs on every pull request push, so a NOTES file edited after the
# notes commit without a matching regeneration fails CI rather than shipping a
# changelog that quietly stopped matching what got published.
#
# Prints to stdout rather than writing $CHANGELOG_FILE directly, so --check can diff it
# against the committed copy without ever touching the working tree — the same split
# build-manifest's generate()/--check makes, though not its shape: build-manifest is
# free-standing because MANIFEST needs nothing from it, where this depends on
# $NOTES_DIR, $DRAFT_SENTINEL and is_version(), all already bin/release's.
#
# Refuses outright in a shallow clone, rather than resolving each version's date and
# quietly writing none for the ones it cannot see. A shallow clone cannot tell "not
# tagged yet" from "tagged, but the ref did not come along" — proven by running this
# very function against one: every date it already had came back blank. Silently
# regenerating from there would commit that loss.
changelog_content() {
  local f base version date

  if [ "$(git rev-parse --is-shallow-repository 2>/dev/null || echo true)" != "false" ]; then
    echo "❌ this is a shallow clone (or its depth could not be checked), and CHANGELOG.md" >&2
    echo "   needs full tag history to tell a version with no date yet from one whose date" >&2
    echo "   this clone simply cannot see. Regenerating here would write the second as the" >&2
    echo "   first, erasing it." >&2
    echo "   git fetch --unshallow, or clone without --depth, then try again." >&2
    exit 1
  fi

  {
    echo "# Changelog"
    echo
    echo "One entry per tagged release, generated from [$NOTES_DIR/]($NOTES_DIR/) —"
    echo "each file there is also that release's published GitHub release body. Edit the"
    echo "per-version file, never this one: \`bin/release --changelog\` regenerates it, and"
    echo "\`bin/test\` refuses a stale copy."

    # v*.md, filtered to names whose version parses — a stray or malformed file in
    # NOTES_DIR is skipped rather than aborting the whole regeneration over it. Piped
    # straight into the loop that renders each entry: nothing computed here needs to
    # outlive it.
    for f in "$NOTES_DIR"/v*.md; do
      [ -e "$f" ] || continue
      base="$(basename "$f" .md)"
      version="${base#v}"
      is_version "$version" || continue
      printf '%s %s\n' "$version" "$f"
    done | sort -rV | while IFS=' ' read -r version f; do
      [ -n "$version" ] || continue
      # No local tag for the version currently being drafted — not a bug, and not
      # papered over with today's date. It reads with no date until the next
      # regeneration, normally the next release's --start, picks up the real one.
      date="$(git log -1 --format=%as "v$version" 2>/dev/null || true)"
      echo
      if [ -n "$date" ]; then
        echo "## v$version — $date"
      else
        echo "## v$version"
      fi
      echo
      changelog_body "$f"
    done
  }
}

# For --check only: a version's date can only be known once its tag exists, which is
# after --finish — and nothing can push a refresh commit straight to main afterwards
# (branch protection requires a pull request for every change, admins included, and
# --finish never opens one). So a freshly-tagged entry ships dateless and stays that
# way until something else regenerates CHANGELOG.md in full, typically the next
# release's --start once that tag is visible. Comparing raw output against that
# would fail --check on the very next unrelated pull request the moment CI can see
# the new tag — a stale-content check reporting a mismatch that content drift never
# caused. This strips the date from every heading on both sides first, so --check
# still catches real drift (a NOTES file edited without a matching regeneration)
# without also catching a date becoming resolvable that nobody was in a position to
# commit.
changelog_headings_undated() { sed -E 's/^(## v[0-9]+\.[0-9]+\.[0-9]+)( — 20[0-9]{2}-[0-9]{2}-[0-9]{2})?$/\1/'; }

# `changelog_content >"$CHANGELOG_FILE"` truncates the real file the instant the
# shell opens it for writing — before changelog_content runs a single line — so a
# refusal (a shallow clone, a malformed note) still erases whatever was already
# there. Proven directly: a shallow clone hitting the refusal above left
# CHANGELOG.md at zero bytes, not merely unrefreshed. Write to a temp file in the
# same directory and rename over the real one only once changelog_content has
# actually finished; the trap is what still removes the temp file when
# changelog_content exits outright rather than returning an error, which is how
# every other refusal in this script behaves and this one matches on purpose.
write_changelog() {
  local tmp
  tmp="$(mktemp "$CHANGELOG_FILE.XXXXXX")"
  trap 'rm -f "$tmp"' EXIT
  changelog_content >"$tmp"
  # mktemp creates $tmp at 0600. A same-filesystem `mv` is a rename, which carries
  # the source inode's mode along rather than picking up the destination's —
  # proven by running this and diffing the file's mode before and after: every
  # write quietly took CHANGELOG.md from 644 to 600. Match every other tracked
  # text file in this repo before the rename, not after.
  chmod 644 "$tmp"
  mv "$tmp" "$CHANGELOG_FILE"
  trap - EXIT
}

# Write, or check — mirrors do_verify()'s shape rather than living inline at the
# dispatch site, so the two sibling flags read the same way.
do_changelog() {
  local mode="${1:-}"
  case "$mode" in
    "" | --check) ;;
    *) usage ;;
  esac

  if [ "$mode" = --check ]; then
    # Compared with dates stripped from both sides — see changelog_headings_undated's
    # own comment for why a date-only difference is not drift.
    if diff -q <(changelog_content | changelog_headings_undated) \
              <(changelog_headings_undated <"$CHANGELOG_FILE") >/dev/null 2>&1; then
      echo "✅ $CHANGELOG_FILE matches .github/releases/*.md"
      return 0
    fi
    echo "❌ $CHANGELOG_FILE does not match .github/releases/*.md. Run bin/release --changelog." >&2
    diff <(changelog_content) "$CHANGELOG_FILE" >&2 || true
    return 1
  fi

  write_changelog
  echo "✅ wrote $CHANGELOG_FILE"
  return 0
}

# Trailing whitespace and CRLF differ between what was committed and what the forge
# stores and hands back. Comparing raw text reports a body mismatch for a release
# that is in fact byte-correct in every way a reader would notice.
normalize() { sed 's/\r$//; s/[[:space:]]*$//'; }

# One file, as it exists in the tagged tree, over whichever route answers.
#
# git first, because a fetched tag is the same object the forge has and needs no
# credential beyond the remote's. Then gh, for the same reason remote_versions() has a
# gh route: an SSH remote in an environment with no key fails every git fetch while gh
# answers fine. Without this, --verify could establish that a tag exists and never
# check the one thing it is for — that the tree behind it claims the version the tag
# claims. Observed cutting 0.6.0: the tag read fell back to gh and succeeded, and this
# fetch failed two lines later, leaving the versions "unchecked".
#
# Prints the file. 1 = could not read it by any route.
tagged_file() {
  local tag="$1" path="$2" slug
  if git fetch -q origin "+refs/tags/$tag:refs/tags/$tag" 2>/dev/null; then
    git show "$tag:$path" 2>/dev/null && return 0
  fi
  have_gh || return 1
  slug="$(repo_slug)" || return 1
  [ -n "$slug" ] || return 1
  # -H Accept:...raw returns the file itself rather than base64 in JSON, so this needs
  # no decoder and cannot half-decode a file into something that parses as valid JSON.
  gh api -H "Accept: application/vnd.github.raw" \
    "repos/$slug/contents/$path?ref=$tag" 2>/dev/null
}

# ── --verify ─────────────────────────────────────────────────────────────────

# Verify one published release. Prints findings, returns 1 if any.
#
# This is the "verify before declaring done" step. Pushing a tag is not the same as
# a release existing: the publish workflow can refuse (missing notes, a version
# disagreement, an already-published tag) long after the person who pushed has
# stopped watching, and CI does not run on tags at all, so nothing else ever looks.
# Prints the release body. 0 = published, 1 = genuinely absent, 2 = could not tell.
#
# The three have to stay apart. An unauthenticated or rate-limited call fails exactly
# like a missing release, and reporting "no release behind this tag" because the
# token expired is a false finding that reads identically to a true one — it sends
# someone to re-publish a release that is already live.
gh_release_body() {
  local tag="$1" out err rc
  # stderr to a file rather than merged into stdout. Merging is the easy way to classify
  # the failure, but it also means anything gh writes to stderr on a *successful* call —
  # a scope notice, a proxy or TLS warning, GH_DEBUG output — lands inside the body and
  # shows up as a body that does not match its notes.
  err="$(mktemp)"
  out="$(gh api "repos/{owner}/{repo}/releases/tags/$tag" --jq '.body' 2>"$err")" && rc=0 || rc=$?
  if [ "$rc" -eq 0 ]; then
    rm -f "$err"
    printf '%s' "$out"
    return 0
  fi
  out="$(cat "$err")"
  rm -f "$err"
  # Anchored on gh's own "(HTTP nnn)" suffix, not a bare 404 substring. Unanchored, a
  # proxy error carrying a request id like 4048812, or a gateway page reading "…was Not
  # Found on this proxy", classifies as a missing release — the exact false finding this
  # function exists to prevent, and it clusters behind the same authenticating proxies
  # that produce the auth failures it is separating. A format gh stops using would make
  # a real 404 read as "could not tell", which is the safe direction to be wrong in.
  case "$out" in
    *"(HTTP 404)"*) return 1 ;;
    *)
      printf '%s\n' "$out" | sed 's/^/     /' >&2
      return 2
      ;;
  esac
}

verify_one() {
  local version="$1" tag="v$1" found=0 body published notes rc

  if ! printf '%s\n' "$REMOTE_VERSIONS" | grep -qxF "$version"; then
    echo "  ❌ $tag is not a tag on origin"
    return 1
  fi

  # The tagged tree is checked FIRST, and unconditionally. It is pure git and needs no
  # forge credential, so making it wait behind the release lookup meant a GitHub outage
  # hid a genuine version mismatch — and the case where that matters most is a tag with
  # no release behind it, where the wrong version is about to be published rather than
  # already public.
  #
  # The tree the tag points at, not the working tree. That tree is the artifact, and
  # it is what every adopting repository installs.
  #
  # The leading + is load-bearing. Without it git refuses to move a local tag that has
  # diverged from the remote — "would clobber existing tag" — which is exactly the case
  # this check exists to catch, so the check would fail precisely when it mattered and
  # then read the stale local tag anyway. The refusal prints one line above a `git show`
  # whose output looks perfectly fine, which makes it a confident wrong answer rather
  # than a visible error. And a fetch that fails for any other reason is reported, not
  # skipped past: the local tag is not evidence about what was published.
  local f got
  for f in "$PLUGIN_JSON" "$MARKET_JSON"; do
    if got="$(tagged_file "$tag" "$f" | sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -1)" &&
      [ -n "$got" ]; then
      [ "$got" = "$version" ] || { echo "  ❌ $tag: $f says $got"; found=1; }
    else
      echo "  ⚠️  $tag: could not read $f from the tagged tree, over git or gh"
      echo "     The version it ships is unchecked — not confirmed correct."
      found=1
    fi
  done

  # Only the explicit, immutable list of releases cut before native Codex packaging may
  # omit this manifest. Treating every absent path as historical would let a future tag
  # publish after accidentally deleting the Codex package; checking the allowlist before
  # local git state also prevents a stale local tag from laundering a network failure.
  if got="$(tagged_file "$tag" "$CODEX_JSON" | sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -1)" &&
    [ -n "$got" ]; then
    [ "$got" = "$version" ] || { echo "  ❌ $tag: $CODEX_JSON says $got"; found=1; }
  elif grep -qxF "$tag" "$CODEX_PRE_NATIVE_TAGS"; then
    echo "  ℹ️  $tag predates native Codex packaging; no Codex manifest to verify"
  else
    echo "  ⚠️  $tag: could not read $CODEX_JSON from the tagged tree, over git or gh"
    echo "     The version it ships is unchecked — not confirmed correct."
    found=1
  fi

  # A published body that is still the scaffold. The workflow refuses one now, but a
  # release cut before that check existed — or published by hand — carries it for ever,
  # and the body/file comparison below passes because the file is the scaffold too.
  if [ -s "$NOTES_DIR/$tag.md" ] && grep -qF -- "$DRAFT_SENTINEL" "$NOTES_DIR/$tag.md"; then
    echo "  ❌ $tag: the notes are still the generated draft"
    found=1
  fi

  # Now ask the forge. Kept after the git-only checks so its failure cannot suppress them.
  published="$(gh_release_body "$tag")" && rc=0 || rc=$?
  case "$rc" in
    1)
      echo "  ❌ $tag is tagged, but no release exists behind it"
      echo "     Publish it: gh workflow run release.yml -f tag=$tag"
      return 1
      ;;
    2)
      echo "  ⚠️  $tag: could not ask GitHub whether a release exists — not checked"
      return 1
      ;;
  esac

  # An empty body is the one body difference that is never a deliberate edit: it means
  # the release object exists carrying nothing, which is a publish that half-failed. The
  # ℹ️-never-fails rule below is right for edits and wrong for this.
  if [ -z "$published" ] || [ "$published" = "null" ]; then
    echo "  ❌ $tag: the release exists but its body is empty"
    found=1
  fi

  # Reported, never failed. The publish workflow reads the body from the default branch
  # rather than from the tag, precisely so prose can be corrected after a tag is cut —
  # and CLAUDE.md says a superseded release is better marked superseded than removed.
  # Both mean the file legitimately moves on after publication, so treating a difference
  # as a finding would make every corrected release permanently red, and a check that is
  # red for a good reason teaches people to stop reading it.
  notes="$NOTES_DIR/$tag.md"
  if [ -s "$notes" ]; then
    body="$(printf '%s' "$published" | normalize)"
    if [ "$body" != "$(normalize <"$notes")" ]; then
      echo "  ℹ️  $tag: $notes has changed since it was published (edits are allowed)"
    fi
  else
    # ℹ️ rather than ⚠️, deliberately. Every ⚠️ in this function sets found=1; this one
    # never did, so it printed a warning and then "✅ nothing to fix" two lines later.
    # A symbol that the summary contradicts is worse than no symbol.
    echo "  ℹ️  $tag: no $notes to compare the published body against"
  fi

  [ "$found" -eq 0 ] && echo "  ✅ $tag"
  return "$found"
}

do_verify() {
  local want="${1:-}"

  # This is a shell script, so gh is the only route it has. A Claude Code session has a
  # second one and should use it rather than skip the check: /riprap:release makes the
  # same assertions through the GitHub MCP tools, which carry their own credential and
  # so tend to work in exactly the sessions where gh does not.
  have_gh || {
    echo "❌ --verify needs the gh CLI, and it is not on PATH." >&2
    echo "   In a Claude Code session, /riprap:release checks the same things via MCP." >&2
    exit 1
  }

  # A tag list that failed to fetch is not an empty tag list. Continuing on a
  # truncated source manufactures "no release behind this tag" findings for tags it
  # simply never saw, which is worse than not running: it is a false report that
  # reads exactly like a true one.
  REMOTE_VERSIONS="$(remote_versions)" || {
    echo "❌ could not read tags from origin. Nothing checked." >&2
    exit 1
  }

  # Same reasoning one level up: prove the credential works before drawing any
  # conclusion from what GitHub does not return. Without this, an expired token
  # turns the whole sweep into a list of releases that all look missing.
  #
  # It proves repository metadata is readable, which is not the same as releases being
  # readable: a fine-grained token with metadata but not contents passes here and then
  # receives genuine 404s from the releases endpoint. That gap is why a 404 is reported
  # as a finding to act on rather than acted on automatically.
  gh api "repos/{owner}/{repo}" --jq '.full_name' >/dev/null 2>&1 || {
    echo "❌ gh cannot reach this repository — check 'gh auth status'. Nothing checked." >&2
    echo "   In a Claude Code session, /riprap:release checks the same things via MCP." >&2
    exit 1
  }

  local rc=0
  if [ -n "$want" ]; then
    is_version "$want" || { echo "❌ not a version: $want" >&2; exit 2; }
    echo "Checking v$want"
    verify_one "$want" || rc=1
  else
    [ -n "$REMOTE_VERSIONS" ] || { echo "No v* tags on origin."; return 0; }
    echo "Checking every v* tag on origin"
    # Per-tag failures are reported and the sweep continues. A reconciler that stops
    # at the first finding hides every finding after it, and the second one is the
    # one nobody knew about.
    local v
    while IFS= read -r v; do
      [ -n "$v" ] || continue
      verify_one "$v" || rc=1
    done <<<"$REMOTE_VERSIONS"
  fi

  [ "$rc" -eq 0 ] && echo "✅ nothing to fix"
  return "$rc"
}

# ── CI status, advisory ──────────────────────────────────────────────────────

# 0 green, 1 not green, 2 could not tell. Never fatal on its own: gh is optional
# here, and a release should not become impossible because GitHub is unreachable.
#
# Worth knowing while reading the output: riprap's CI does not run on tags. The run
# on the merge commit is the only evidence a release ever gets, which is why it is
# checked here rather than left to the publish workflow to notice.
ci_status() {
  local sha="$1" runs total bad
  have_gh || { echo "⚠️  gh not on PATH — CI status not checked."; return 2; }
  command -v jq >/dev/null 2>&1 || { echo "⚠️  jq not on PATH — CI status not checked."; return 2; }

  # --paginate, because the endpoint pages at 30 and a red check on page two would
  # otherwise read as "30 checks green". Flattened to one line per run at the API
  # boundary so the counting below cannot drift from what was actually fetched — a
  # total taken from the response's total_count against a page's worth of runs is the
  # same bug wearing a bigger number.
  runs="$(gh api --paginate "repos/{owner}/{repo}/commits/$sha/check-runs?per_page=100" \
    --jq '.check_runs[] | [(.conclusion // .status // "pending"), .name] | @tsv' 2>/dev/null)" || {
    echo "⚠️  could not reach GitHub — CI status not checked."
    return 2
  }

  total="$(printf '%s' "$runs" | grep -c . || true)"
  [ "$total" -gt 0 ] || { echo "⚠️  no check runs recorded for $sha."; return 2; }

  bad="$(printf '%s' "$runs" | grep -vcE '^(success|neutral|skipped)	' || true)"
  if [ "$bad" -eq 0 ]; then
    echo "✅ $total CI check(s) green on $sha"
    return 0
  fi
  echo "⚠️  $bad of $total CI check(s) not green on $sha:"
  printf '%s' "$runs" | grep -vE '^(success|neutral|skipped)	' | sed 's/^/     /'
  return 1
}

# ── main ─────────────────────────────────────────────────────────────────────

[ $# -ge 1 ] || usage

if [ "$1" = "--verify" ]; then
  [ $# -le 2 ] || usage
  do_verify "${2:-}"
  exit $?
fi

# Ahead of VERSION="$1" below, which would otherwise swallow --changelog as a version
# argument and fail it with a confusing "not a version" error.
if [ "$1" = "--changelog" ]; then
  [ $# -le 2 ] || usage
  do_changelog "${2:-}"
  exit $?
fi

case "$1" in -h | --help) usage ;; esac

VERSION="$1"
shift

# --start and --finish do not change what a release is; they carry the acts nobody
# was making a decision about. Everything they add is either mechanical (branch,
# push, open the pull request, fetch, watch) or already mandatory (draft the notes,
# verify afterwards). The two gates stay exactly where they were: a human merges the
# pull request, and a human types the command that pushes the tag.
MODE=plain
if [ $# -gt 0 ]; then
  case "$1" in
    --start) MODE=start; shift ;;
    --finish) MODE=finish; shift ;;
    *) usage ;;
  esac
fi
[ $# -eq 0 ] || usage

# --finish needs gh, and refuses without it rather than pushing blind.
#
# Everything --finish adds over the plain path is a question for the forge: are the
# checks green, did the publish workflow succeed, does the release exist. Without gh
# it can answer none of them and would push anyway — which is strictly worse than the
# plain path, because that one at least leaves the tag local and deletable. "Could not
# check" is not "checked and fine", least of all on the act that cannot be undone.
if [ "$MODE" = finish ] && { ! have_gh || ! command -v jq >/dev/null 2>&1; }; then
  echo "❌ --finish needs both the gh CLI and jq, and one of them is not on PATH." >&2
  echo "   It exists to check the things only the forge knows — that CI is green, that" >&2
  echo "   the publish succeeded, that the release is really there. Without gh it would" >&2
  echo "   push the tag having verified none of them." >&2
  echo >&2
  echo "   Install gh, or tag by hand and keep the steps visible:" >&2
  echo "     bin/release $VERSION      # tags, pushes nothing" >&2
  echo "     git push origin v$VERSION" >&2
  exit 1
fi

# F9. Pin every gh placeholder to ORIGIN, once, rather than at each call site.
#
# `repos/{owner}/{repo}` prefers an `upstream` remote and is overridden by $GH_REPO, so
# on a fork the draft would mix origin's tag list with upstream's merge dates and titles,
# and --start would open the release pull request against the parent repository. This is
# the same hazard repo_slug() was added for; exporting it covers the call sites that
# still use the placeholder, and gh's own --repo resolution too.
if have_gh; then
  GH_SLUG="$(repo_slug || true)"
  [ -z "$GH_SLUG" ] || export GH_REPO="$GH_SLUG"
fi

TAG="v$VERSION"

# Three components, digits only, and no leading v — the argument is the version,
# the tag is what gets a v. Taking both spellings means two names for one release
# and a guess about which one the notes file is called. The tag drives the
# published version, so a typo here is a release nobody can install.
if ! is_version "$VERSION"; then
  # "$VERSION", not "$1": the mode flag is shifted off above, so $1 is gone by here.
  # Under `set -u` that is an abort with a bash diagnostic instead of this message.
  echo "❌ not a version: $VERSION (expected x.y.z, no leading v, no leading zeros)" >&2
  exit 2
fi

for f in "$PLUGIN_JSON" "$CODEX_JSON" "$MARKET_JSON"; do
  [ -f "$f" ] || { echo "❌ missing $f" >&2; exit 1; }
done

# Tags from origin — over git, or over gh, and if neither answers then not at all.
#
# This used to fall back to the local tag cache with a warning. That is the one
# source git will not correct on its own: a plain `git fetch --tags` declines to move
# an existing ref without --force, so a tag someone pushed an hour ago is invisible in
# it, and both checks fed from here are checks that cannot be taken back — re-cutting
# a published version, or moving one backwards. A warning is not a gate: it scrolls
# past, and the release proceeds on the stale answer either way.
#
# So it refuses. An honest stop beats a confident wrong answer about the one number
# that is spent forever once it ships.
if ! REMOTE_VERSIONS="$(remote_versions)"; then
  echo "❌ could not read the tag list from origin, over git or gh." >&2
  echo "   Not falling back to the local tag cache: git will not move an existing tag" >&2
  echo "   ref without --force, so a tag pushed since your last fetch is invisible in it," >&2
  echo "   and this feeds the two checks that cannot be undone — re-cutting a published" >&2
  echo "   version, and moving one backwards." >&2
  echo >&2
  echo "   Fix the remote or authenticate gh, then run this again:" >&2
  echo "     git ls-remote --tags origin >/dev/null && echo ok" >&2
  echo "     gh auth status" >&2
  exit 1
fi
TAG_SOURCE="origin"

if printf '%s\n' "$REMOTE_VERSIONS" | grep -qxF "$VERSION"; then
  echo "❌ $TAG already exists on $TAG_SOURCE. A published version does not get re-cut." >&2
  exit 1
fi

# Tagged locally but not pushed. The likely sequence is a successful second run followed
# by a distraction, then a re-run to get the push line back — and without this, `git tag`
# aborts with a raw "fatal: tag already exists" and exit 128, the one refusal in the
# script that neither explains itself nor says what to do next.
if git rev-parse -q --verify "refs/tags/$TAG" >/dev/null; then
  # Mode-aware, because the modes reach this from different places and only one of
  # them can be answered with "just push it".
  #
  # --finish gets here on the natural retry after a failed push, and exiting 0 there
  # is a green exit from the publishing command with nothing published. --start gets
  # here with a stale tag from an abandoned run, and its advice would push a tag
  # pointing at an old commit — which the workflow refuses and the version is then
  # spent, because a pushed tag is never withdrawn.
  TAGGED_AT="$(git rev-parse --short "$TAG^{commit}")"
  case "$MODE" in
    finish)
      if [ "$(git rev-parse "$TAG^{commit}")" != "$(git rev-parse HEAD)" ]; then
        echo "❌ $TAG already exists locally at $TAGGED_AT, which is not HEAD." >&2
        echo "   It was cut from a different commit. Delete it and re-run:" >&2
        echo "     git tag -d $TAG" >&2
        exit 1
      fi
      echo "ℹ️  $TAG already tagged locally at $TAGGED_AT — continuing to push and verify."
      SKIP_TAGGING=1
      ;;
    start)
      echo "❌ $TAG already exists locally, at $TAGGED_AT." >&2
      echo "   --start opens the pull request; it never tags, so this is left over from" >&2
      echo "   an abandoned run. Delete it before starting again:" >&2
      echo "     git tag -d $TAG" >&2
      exit 1
      ;;
    *)
      echo "✅ $TAG already exists locally, at $TAGGED_AT."
      echo "   Nothing to do but push it:"
      echo
      echo "     git push origin $TAG"
      echo "     bin/release --verify $VERSION"
      exit 0
      ;;
  esac
fi

# Forwards only, and against the highest tag rather than the last one cut. The
# existing-tag check above catches re-cutting a version; it does not catch going
# backwards to one that was never tagged. A version that moves down installs as an
# older plugin in every adopting repository, and unlike a wrong tag there is nothing
# on the release page that looks wrong.
HIGHEST="$(printf '%s\n' "$REMOTE_VERSIONS" | tail -1)"
if [ -n "$HIGHEST" ] && ! is_greater "$VERSION" "$HIGHEST"; then
  echo "❌ $VERSION is not ahead of $HIGHEST, the highest tag on $TAG_SOURCE." >&2
  exit 1
fi

# Tracked changes only, which is the set that matters: the commit below stages the
# version files by path, so an untracked file cannot be swept into it. What a
# dirty tree does threaten is the thing being tagged — an uncommitted edit is not
# in the commit the tag points at, so the tree you tested is not the tree you ship.
if ! git diff --quiet || ! git diff --cached --quiet; then
  echo "❌ uncommitted changes to tracked files. Commit or stash first." >&2
  echo "   They would not be in the commit this tags, so the tag would not be what you tested." >&2
  exit 1
fi

# Refused here rather than in CI. The workflow makes the same check, but by then
# the tag is pushed and public, and the fix is a second tag or a deleted one.
NOTES="$NOTES_DIR/$TAG.md"
# Still the generated scaffold. Checked on every path that leads to a tag, because
# --start writes this file and pushes it, and nothing downstream reads it for meaning:
# the workflow only tests that it is non-empty, and verify_one only checks that the
# published body matches it — both pass on an unedited draft.
# Not in start mode. --start never tags, it COMMITS the sentinel-bearing draft on
# purpose ("edit it before this merges"), and refusing here left an interrupted run —
# a failed push, say — with no way forward: every re-run refused with tag-path advice
# for a mode that never tags, and following that advice landed on "nothing to start".
if [ "$MODE" != start ] && [ -s "$NOTES" ] && grep -qF -- "$DRAFT_SENTINEL" "$NOTES"; then
  echo "❌ $NOTES is still the generated draft." >&2
  echo "   The release workflow publishes it verbatim, so this would ship a TODO as the" >&2
  echo "   release body. Write it, delete the marker line, and commit." >&2
  exit 1
fi

NEED_DRAFT=0
if [ ! -s "$NOTES" ]; then
  if [ "$MODE" = start ]; then
    # Deferred until the branch exists. Drafting here wrote the file before the
    # branch-point and WIP-branch refusals below, so a run that correctly refused
    # still left a scaffold behind — and the sentinel check above then refused the
    # NEXT run too, from the right branch, for a file the last refusal created.
    NEED_DRAFT=1
  else
    echo "❌ no release notes at $NOTES" >&2
    echo "   The release workflow publishes that file as the body and refuses without it." >&2
    echo "   \`bin/release $VERSION --start\` drafts one from what merged." >&2
    exit 1
  fi
fi


plugin_was="$(version_in "$PLUGIN_JSON")"
codex_was="$(version_in "$CODEX_JSON")"
market_was="$(version_in "$MARKET_JSON")"
BRANCH="$(git rev-parse --abbrev-ref HEAD)"
DEFAULT="$(default_branch)"

# --finish is the second act, and it has nothing to do until the first one merged.
# Without this it fell into the bump path like plain mode, committed the bump, printed
# "git push -u origin main", and exited 0 — pushing a CODEOWNERS-gated change straight
# at the default branch, which is the whole thing the two-run split exists to stop.
if [ "$MODE" = finish ] && { [ "$plugin_was" != "$VERSION" ] ||
  [ "$codex_was" != "$VERSION" ] || [ "$market_was" != "$VERSION" ]; }; then
  echo "❌ the tree here does not say $VERSION, so there is nothing to finish:" >&2
  echo "     $PLUGIN_JSON: $plugin_was" >&2
  echo "     $CODEX_JSON: $codex_was" >&2
  echo "     $MARKET_JSON: $market_was" >&2
  echo >&2
  echo "   Either the bump has not merged — open the pull request:" >&2
  echo "     bin/release $VERSION --start" >&2
  echo "   or it has, and this checkout is stale:" >&2
  echo "     git checkout $DEFAULT && git pull && bin/release $VERSION --finish" >&2
  exit 1
fi

if [ "$plugin_was" != "$VERSION" ] || [ "$codex_was" != "$VERSION" ] ||
   [ "$market_was" != "$VERSION" ]; then
  # ── First run: bump and commit. Deliberately no tag. ──
  #
  # The version files are CODEOWNERS-gated, so this commit becomes a pull request.
  # Tagging it here would produce a tag pointing at a commit the squash-merge
  # discards, whose only remaining use is to be deleted again before the real one
  # can be cut. A step whose entire purpose is to be undone is a step to not take.
  # Backwards is refused; already-there is not. The two files can disagree — a failed
  # substitution leaves the first rewritten and the second not, and so does a partial
  # revert — and requiring both to be strictly behind made that state unrecoverable:
  # the file already at the target is not "ahead of" itself, so the bump could never
  # complete and the message named one version twice without saying which file was
  # stuck. Naming the file matters more here than anywhere else in this script.
  for pair in "$PLUGIN_JSON:$plugin_was" "$CODEX_JSON:$codex_was" \
              "$MARKET_JSON:$market_was"; do
    was="${pair#*:}"
    if [ "$was" != "$VERSION" ] && is_greater "$was" "$VERSION"; then
      echo "❌ ${pair%%:*} says $was, which is ahead of $VERSION. Nothing committed." >&2
      exit 1
    fi
  done

  # --start branches from the default branch and refuses anywhere else.
  #
  # The refusal is the point, and an earlier draft got it wrong: the condition only
  # decided whether to CREATE a branch, so on a feature branch it fell through and
  # committed the release onto somebody's work in progress, then pushed that branch and
  # opened a pull request titled "Ship x.y.z" carrying it. Merging that ships the WIP.
  #
  # The branch POINT is checked too. Being on $DEFAULT is not the same as being at what
  # $DEFAULT is on the remote: a local commit nobody has seen rides along exactly the
  # same way, and the pull request body this writes asserts it carries two commits.
  if [ "$MODE" = start ]; then
    case "$BRANCH" in
      "$DEFAULT" | HEAD | "ship-$VERSION") ;;
      *)
        echo "❌ --start cuts from $DEFAULT, and you are on $BRANCH." >&2
        echo "   The bump would ride along with whatever else is on this branch, and the" >&2
        echo "   pull request would carry it under the title \"Ship $VERSION\"." >&2
        echo "   git checkout $DEFAULT && git pull, then run this again." >&2
        exit 1 ;;
    esac

    git fetch -q origin "$DEFAULT" 2>/dev/null || true

    # The branch point is checked on BOTH paths. It used to sit inside the "not already
    # on ship-x" arm, so the re-run the error text below steers people onto skipped it
    # entirely — and a leftover ship branch cut from an old main, or carrying stray
    # commits, got the bump committed on top and opened as a pull request whose body
    # asserts it carries two. That is the ride-along hole, reopened on the resume path.
    #
    # A ship branch is acceptable when it is on origin/$DEFAULT, or when it is already
    # published (an interrupted run resuming against its own pushed branch).
    if ! git rev-parse -q --verify "refs/remotes/origin/$DEFAULT" >/dev/null ||
       ! git merge-base --is-ancestor HEAD "refs/remotes/origin/$DEFAULT" 2>/dev/null; then
      if [ "$BRANCH" = "ship-$VERSION" ] &&
         git rev-parse -q --verify "refs/remotes/origin/ship-$VERSION" >/dev/null &&
         [ "$(git rev-parse HEAD)" = "$(git rev-parse "refs/remotes/origin/ship-$VERSION")" ]; then
        : # resuming on the branch this already pushed
      else
        echo "❌ HEAD is not on origin/$DEFAULT, so a release cut here would carry" >&2
        echo "   commits nobody has reviewed. Get to what shipped first:" >&2
        echo "     git checkout $DEFAULT && git pull" >&2
        exit 1
      fi
    fi

    if [ "$BRANCH" != "ship-$VERSION" ]; then
      git checkout -q -b "ship-$VERSION" || {
        echo "❌ could not create branch ship-$VERSION — does it already exist?" >&2
        echo "   git branch -D ship-$VERSION, or check it out and re-run." >&2
        exit 1; }
      # Assert the switch rather than assuming it. This environment has a recorded case
      # of `git checkout -b` creating the ref while HEAD stayed put — after which both
      # release commits land on the default branch, the pushed ship branch is empty, and
      # `gh pr create` fails with "no commits between" that the handler below misreports.
      BRANCH="$(git branch --show-current)"
      [ "$BRANCH" = "ship-$VERSION" ] || {
        echo "❌ created ship-$VERSION but HEAD is on ${BRANCH:-a detached commit}." >&2
        echo "   Nothing has been committed. Switch to it and re-run:" >&2
        echo "     git checkout ship-$VERSION" >&2
        exit 1; }
      echo "🌱 branched $BRANCH off $DEFAULT"
    fi
    if [ "$NEED_DRAFT" -ne 0 ]; then
      # `x || draft_notes` suspends errexit for the entire function body, so a failed
      # redirect still printed "📝 drafted" and returned 0 — after which no notes commit
      # was made and the pull request body claimed two commits while carrying one.
      draft_notes "$NOTES"
      [ -s "$NOTES" ] || { echo "❌ $NOTES was not written." >&2; exit 1; }
    fi
  fi

  # Detached HEAD makes the guidance below unrunnable — BRANCH is the literal string
  # "HEAD", `git push -u origin HEAD` is rejected as not a full refname, and the next
  # printed line would orphan the commit just made. Refuse before writing anything.
  if [ "$BRANCH" = "HEAD" ]; then
    echo "❌ HEAD is detached. Check out a branch first — the bump has to become a" >&2
    echo "   pull request, and a commit made here belongs to no branch to open one from." >&2
    exit 1
  fi

  # The notes go in their own commit, before the bump, so the pull request reads in the
  # order the release happened and a reviewer can see the prose apart from the numbers.
  #
  # CHANGELOG.md is regenerated and rides in the same commit — whether $NOTES was just
  # auto-drafted above or was written by hand before this ran, both reach here. It will
  # still carry $DRAFT_SENTINEL if $NOTES does; that is expected; `bin/test` refuses a
  # merge where the two have drifted, which is what forces a re-run of --changelog once
  # $NOTES is actually finished.
  if [ "$MODE" = start ] && ! git diff --quiet -- "$NOTES" 2>/dev/null ||
     { [ "$MODE" = start ] && [ -n "$(git ls-files --others --exclude-standard -- "$NOTES")" ]; }; then
    write_changelog
    git add -- "$NOTES" "$CHANGELOG_FILE"
    git commit -q -m "Write the $TAG release notes" \
      -m "The release workflow publishes this file as the body and refuses a tag
without one, so it lands before the bump rather than after the tag.

CHANGELOG.md is regenerated alongside it — bin/release --changelog." ||
      { echo "❌ could not commit $NOTES — see above." >&2; exit 1; }
    echo "✅ committed $NOTES and $CHANGELOG_FILE"
  fi

  set_version "$PLUGIN_JSON" "$VERSION"
  set_version "$CODEX_JSON" "$VERSION"
  set_version "$MARKET_JSON" "$VERSION"
  git add -- "$PLUGIN_JSON" "$CODEX_JSON" "$MARKET_JSON"

  # A commit can fail for reasons that have nothing to do with this script — a rejecting
  # pre-commit hook, a broken signing key. riprap installs such a hook into its own
  # repository, so this is not hypothetical. Left alone, `set -e` would abort here with
  # only the hook's output, leaving both files rewritten and staged: every later run then
  # refuses with "uncommitted changes", and the advice it gives ("commit or stash") makes
  # the bump commit without the message this script exists to write. Undo it and say so.
  if ! git commit -q -m "Ship $VERSION" \
    -m "The Claude, Codex, and marketplace manifests move together, because the release
workflow refuses a tag whose tree claims a different version than the tag does."; then
    git restore --staged --worktree -- "$PLUGIN_JSON" "$CODEX_JSON" "$MARKET_JSON" 2>/dev/null ||
      git checkout -- "$PLUGIN_JSON" "$CODEX_JSON" "$MARKET_JSON"
    echo "❌ the commit was rejected — see above. All version files put back as they were." >&2
    exit 1
  fi
  echo "✅ $plugin_was → $VERSION in all manifests, committed on $BRANCH"

  if [ "$MODE" != start ]; then
    cat <<NEXT

No tag yet, and that is deliberate: the tag has to end up on the commit that
merged, not on this one. Get the bump merged, then run this again on the merged
commit and it will only tag.

  git push -u origin $BRANCH
  # open the pull request, let CI go green, merge it
  git checkout $DEFAULT && git pull
  bin/release $VERSION
NEXT
    exit 0
  fi

  # ── --start: push, and open the pull request ──
  #
  # Still no tag. What this removes is four keystrokes, not the gate: the pull request
  # is exactly the one a person would have opened, and it is a person who merges it.
  git push -q -u origin "$BRANCH" || {
    echo "❌ could not push $BRANCH. The commits are made; push and open the PR by hand." >&2
    exit 1; }
  echo "⬆️  pushed $BRANCH"

  if ! have_gh; then
    echo "ℹ️  no gh, so the pull request is yours to open:"
    echo "     https://github.com/<owner>/<repo>/compare/$DEFAULT...$BRANCH"
  elif PR_URL="$(gh pr create --base "$DEFAULT" --head "$BRANCH" --title "Ship $VERSION" \
      --body "Cuts \`$TAG\`. Two commits: the release notes, then the version bump.

The body the workflow publishes is [\`$NOTES\`]($NOTES) — read it as the release, not as a diff.

Not tagged yet, deliberately: the version files are CODEOWNERS-gated, so the bump merges as a pull request, and the tag belongs on the commit that merge produces. After this merges:

\`\`\`
git checkout $DEFAULT && git pull
bin/release $VERSION --finish
\`\`\`

🤖 Generated with [Claude Code](https://claude.com/claude-code)" 2>/dev/null)"; then
    echo "🔗 $PR_URL"
  else
    echo "ℹ️  gh could not open the pull request (already open, or unauthenticated)."
    echo "   Open it by hand against $DEFAULT from $BRANCH."
  fi

  cat <<NEXT

Then, once it is merged and green:

  git checkout $DEFAULT && git pull
  bin/release $VERSION --finish
NEXT
  exit 0
fi

# All manifests already say $VERSION. --start has nothing left to do, and saying so
# beats silently falling through into the tag path — which is the one act it is not
# allowed to take.
if [ "$MODE" = start ]; then
  echo "❌ all version files already say $VERSION, so there is nothing to start." >&2
  echo "   If the bump has merged, the next act is: bin/release $VERSION --finish" >&2
  exit 1
fi

# ── Second run: all manifests already say $VERSION, so tag. ──

# Refresh the default branch before asking whether HEAD is on it. A stale
# origin/$DEFAULT answers the question about where the branch was, not where it is,
# and this check exists precisely because the commit moved.
git fetch -q origin "$DEFAULT" 2>/dev/null ||
  echo "⚠️  could not fetch origin/$DEFAULT — checking against the ref you already have." >&2

# Fail closed. Everything above this point degrades to a warning when origin is
# unreachable — the tag list falls back to the local cache, the fetch is skipped — and
# on their own each of those is a reasonable degradation. Composed, they used to end in
# a green ✅ tagging an arbitrary unmerged branch after four warnings nobody reads,
# which is the opposite of what this script claims to guarantee. An unevaluated check is
# not a passed check, and this is the last one standing between a typo and a published
# release built from a commit that is not on the default branch.
if ! git rev-parse -q --verify "refs/remotes/origin/$DEFAULT" >/dev/null; then
  echo "❌ no origin/$DEFAULT to check HEAD against. Nothing tagged." >&2
  echo "   Without it there is no way to tell whether this commit is the one that" >&2
  echo "   merged, and that is the whole question this run exists to answer." >&2
  echo "   Fetch the default branch and try again: git fetch origin $DEFAULT" >&2
  exit 1
fi

if ! git merge-base --is-ancestor HEAD "refs/remotes/origin/$DEFAULT"; then
  echo "❌ HEAD is not on origin/$DEFAULT. Nothing tagged." >&2
  echo "   Publishing this would build the release from a commit that is not on the" >&2
  echo "   default branch, and a squash-merge will discard it. Merge the bump, then" >&2
  echo "   run this again on the merged commit." >&2
  exit 1
fi

# On the default branch but behind its tip: legitimate — the bump commit is what should
# wear the tag — but not silent. Anything merged after it is in the release's history
# and not in its notes, and that is worth seeing before the tag is pushed.
BEHIND="$(git rev-list --count "HEAD..refs/remotes/origin/$DEFAULT" 2>/dev/null || echo 0)"
if [ "$BEHIND" -gt 0 ]; then
  echo "⚠️  origin/$DEFAULT has $BEHIND commit(s) after this one; they ship in $TAG" >&2
  echo "   without appearing in its notes. Tag the tip instead if that is wrong." >&2
fi

# Advisory, per the note on ci_status: reported, and confirmable, never a hard stop.
# What it must not become is a check you learn to skip — a red check waved through
# is how a release ships with the manifest out of date or a scrub finding in it.
set +e
ci_status "$(git rev-parse HEAD)"
CI_RC=$?
set -e
# Only a check that came back red asks for confirmation. A status that could not be
# read at all has already said so on its own line, and prompting about it every time
# would train the answer out of anyone who releases without gh installed — which is
# the same habit that lets a genuinely red check through.
# Red always. Unknown only under --finish, which is about to publish and so may not
# act on "could not tell" — while the long form keeps the leniency the comment above
# describes, because its tag stays local and deletable. Scoping this is what keeps
# both comments true; an earlier draft used a bare -ne 0 and made plain mode prompt on
# a status it had always been willing to proceed past.
if [ "$CI_RC" -eq 1 ] || { [ "$MODE" = finish ] && [ "$CI_RC" -ne 0 ]; }; then
  # Prompt on stderr, and require stderr to be a terminal too. Written to stdout it
  # disappears into the pipe under `bin/release 0.5.0 | tee release.log`, and the script
  # looks hung with no visible question.
  if [ -t 0 ] && [ -t 2 ]; then
    if [ "$MODE" = finish ]; then
      printf 'Tag and PUBLISH anyway? [y/N] ' >&2
    else
      printf 'Tag anyway? [y/N] ' >&2
    fi
    read -r reply || reply=n
    case "$reply" in [yY]*) ;; *) echo "Nothing tagged."; exit 1 ;; esac
  elif [ "$MODE" = finish ]; then
    # No terminal and no answer, so the prompt is not a gate — and --finish pushes,
    # which is the act that cannot be taken back. Plain mode may carry on past this
    # (its tag is local, and a local tag deletes cleanly); --finish may not.
    if [ "$CI_RC" -eq 1 ]; then
      echo "❌ checks are RED on $(git rev-parse --short HEAD), and there is no terminal" >&2
      echo "   to confirm from. Fix them, then re-run --finish." >&2
    else
      echo "❌ could not read the checks on $(git rev-parse --short HEAD), and there is" >&2
      echo "   no terminal to confirm from. That is not the same as red — gh, jq or the" >&2
      echo "   network may be the problem, or the checks may not be registered yet." >&2
      echo "   Fix that, or wait, then re-run --finish." >&2
    fi
    echo "   --finish pushes the tag, and a published tag is never withdrawn, so it" >&2
    echo "   refuses rather than asking a question nobody is there to answer." >&2
    exit 1
  else
    echo "⚠️  not a terminal, so nothing to confirm with — tagging anyway." >&2
    echo "   Nothing is pushed, so this tag is still local and deletable." >&2
  fi
fi

if [ "${SKIP_TAGGING:-0}" -eq 0 ]; then
  git tag -a "$TAG" -m "$TAG" HEAD
  echo "✅ tagged $TAG at $(git rev-parse --short HEAD) on $BRANCH"
fi

if [ "$MODE" = finish ]; then
  # The push is still a thing a person typed — they typed --finish, having read the
  # checks above. What it removes is the gap between the push and the verify, which is
  # where releases were being declared done on a workflow nobody watched.
  echo
  echo "⬆️  pushing $TAG — this publishes, and cannot be undone."
  git push -q origin "$TAG" || {
    echo "❌ could not push $TAG. It is tagged locally; push it yourself:" >&2
    echo "     git push origin $TAG" >&2
    exit 1; }
  echo "✅ pushed $TAG"

  # Watch the publish to a conclusion before verifying. A verify run straight after
  # the push finds no release and reports it as never published — which is wrong, and
  # is read as an instruction to publish again.
  if have_gh; then
    echo "⏳ waiting for the publish workflow…"
    watched=timeout
    # branch=$TAG server-side: a tag-push run carries the tag in head_branch, so the
    # forge can select it. Filtering 50 full run objects client-side could page the run
    # out on a busy day, which surfaced as the false timeout below.
    i=0
    while [ "$i" -lt 60 ]; do
      # Poll first, then sleep. Sleeping first spent 5 seconds before ever looking.
      state="$(gh api "repos/$GH_SLUG/actions/runs?event=push&branch=$TAG&per_page=1" 2>/dev/null |
        jq -r 'first(.workflow_runs[]) | .status + ":" + (.conclusion // "")' 2>/dev/null || true)"
      case "$state" in
        completed:success) watched=ok; echo "✅ publish workflow succeeded"; break ;;
        completed:*) echo "❌ publish workflow finished: ${state#completed:}" >&2
                     echo "   Read the run before doing anything else. Publishing by hand" >&2
                     echo "   leaves its next attempt colliding with your release object." >&2
                     exit 1 ;;
      esac
      i=$((i + 1))
      sleep 5
    done

    # A timeout is not a result. Falling through to verify here reported "tagged, but
    # no release exists behind it" for a run that was merely still queued — and then
    # printed the publish-by-hand command whose collision the branch above warns about.
    if [ "$watched" != ok ]; then
      echo "❌ $TAG is pushed, but the publish workflow had not finished after 5 minutes." >&2
      echo "   That is not the same as it having failed, so do NOT publish by hand —" >&2
      echo "   its next attempt would collide with whatever you create. Watch it:" >&2
      echo "     gh run watch \$(gh run list --workflow release.yml --limit 1 --json databaseId --jq '.[0].databaseId')" >&2
      echo "   then confirm with: bin/release --verify $VERSION" >&2
      exit 1
    fi
  fi

  echo
  echo "── verify ──"
  do_verify "$VERSION"
  # Without this, a fully successful --finish falls into the plain-mode epilogue below
  # and ends with "Nothing has been pushed. This publishes it: git push origin $TAG" —
  # after it has pushed, watched and verified. The false line appeared ONLY on the
  # perfect run, because every failure inside this block exits first. A failing verify
  # still exits non-zero above under `set -e`.
  exit 0
fi

cat <<NEXT

Nothing has been pushed. This publishes it:

  git push origin $TAG

Then confirm it actually published — the workflow can still refuse, and a tag with
no release behind it reads as unreleased:

  bin/release --verify $VERSION

If the release turns out to be wrong, supersede it with a patch. A published tag is
never moved or deleted: it is what the version already meant to everyone who read
it, and the notes for a superseded release are worth more marked superseded than
gone.
NEXT
