#!/usr/bin/env bash
# SessionStart hook — put riprap's guardrails into context.
#
# This is how riprap's rules reach the model without touching the project's
# CLAUDE.md. Injecting is strictly better than writing a file there: the project
# owns that file, an inserted block is one more thing to reconcile on every
# update, and a project that never adopted riprap would still be carrying it.
#
# What is emitted is a router, not the rules themselves. It is paid for on every
# turn, so it stays around 150 lines and points at the files rather than
# inlining them — with one exception, the five critical rules, which are
# restated in full because the cost of forgetting them exceeds the cost of
# carrying them.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
DOCS="${PLUGIN_ROOT}/instructions"

[ -r "${DOCS}/README.md" ] || exit 0

router="$(cat "${DOCS}/README.md")"

# The handoff for whatever this session is continuing, if there is one.
#
# Named rather than described. A session that has just been resumed, forked, or
# restarted after compaction has no memory of the path, and hunting for it is the
# one thing it is least equipped to do — so the path is stated outright.
#
# Silent when there is no handoff. This runs on plain startups too, where a line
# about a document that does not exist is pure cost; writing the first one is the
# behavioural rule's job, not this hook's.
#
# THIS IS A SECOND DEFINITION, and it cannot be helped. The first is
# plugin/payload/bin/hooks/riprap/lib/handoff-common.sh, which owns `tmp/handoff`
# and the `<!-- riprap:handoff branch=` marker. This script runs from the plugin
# and must stay inert in a repository that never ran /riprap:install, so it
# cannot source a payload file. Change either constant and it changes in both
# places; ci.yml asserts the two agree, because the failure is silent — the
# router simply stops mentioning handoffs, which reads exactly like not having
# one.
handoff_note=""
project="${CLAUDE_PROJECT_DIR:-$(pwd)}"
newest=""
sole=""
count=0
branch="$(git -C "$project" symbolic-ref --quiet --short HEAD 2>/dev/null || true)"
listing="$(ls -t "${project}"/tmp/handoff/*.md 2>/dev/null || true)"
# The pre-rename directory, read only when the current one is empty. The plugin
# updates on its own schedule while the payload waits for /riprap:install, so an
# adopter mid-task can have the new code pointed at the new directory and their
# actual handoff still in the old one — and being told "no handoff was written"
# when one exists is the worst thing this hook can say.
legacy=""
if [ -z "$listing" ]; then
  listing="$(ls -t "${project}"/tmp/handover/*.md 2>/dev/null || true)"
  [ -z "$listing" ] || legacy=" It is still in the old \`tmp/handover/\` directory — move it to \`tmp/handoff/\` as part of your next rewrite."
fi

# Newest file claiming THIS branch, not newest file: a finished handoff from
# another task stays newest for ever, and announcing it as current work is a lie
# the whole session then acts on.
while IFS= read -r candidate; do
  [ -f "$candidate" ] || continue
  count=$((count + 1))
  [ -n "$sole" ] || sole="$candidate"
  if [ -z "$newest" ] && [ -n "$branch" ] &&
     grep -qF "<!-- riprap:handoff branch=${branch} -->" "$candidate" 2>/dev/null; then
    newest="$candidate"
  fi
done <<EOF
$listing
EOF

# The layout that predates the marker: one handoff carrying none, which nothing
# can be confused with. Two or more unmarked ones are ambiguous, and answering
# anyway is what the marker exists to prevent.
if [ -z "$newest" ] && [ "$count" -eq 1 ] &&
   ! grep -q "riprap:handoff branch=" "$sole" 2>/dev/null; then
  newest="$sole"
fi

if [ -n "$newest" ]; then
  # Repo-relative, per the rule the router itself states two screens further
  # down: an absolute path is the one form that resolves differently for the
  # next reader than it did for the writer.
  rel="${newest#"${project}"/}"
  if head -1 "$newest" 2>/dev/null | grep -q 'NOT A HANDOFF'; then
    handoff_note=$'\n\n---\n\n**No handoff was written before this context was lost.** `'"${rel}"$'` is an automatic capture of git state — it does not say what the work is for, what was agreed, or what done means, because nobody wrote those down. Treat it as raw material: re-establish the goal with the user before acting, then replace it with a real handoff.'
  else
    handoff_note=$'\n\n---\n\n**There is a handoff for this branch: `'"${rel}"$'`.** Read it once and carry its contents into your working state in the same turn; a read can be its last (handoffs.md). Check it against the tree before acting — where they disagree, the tree is what is true and the handoff is what was intended. If it turns out to describe finished work, say so and start a new one rather than editing it.'"${legacy}"
  fi
fi

# What started this session. `resume` and `fork` continue a context that already
# carries an earlier copy of the router, so sending it again pays ~150 lines to
# say what has already been said — on two of the five entry paths.
#
# Read defensively, because this hook must work everywhere:
#
#   - Never from a terminal. `cat` on a tty blocks for ever, and this runs before
#     anything else in the session. `[ -t 0 ]` is the guard.
#   - Only with jq. Parsing JSON with sed is how a hook starts believing a
#     `"source"` that appeared inside somebody's prompt text, and jq is NOT a
#     dependency of this half — the payload hooks may demand it, but the router
#     has to reach the model on a machine that has never installed it.
#
# Both fall back to the empty string, which takes the full-router branch. The
# optimisation is best-effort by construction; the safe answer is the old one.
source=""
if [ ! -t 0 ] && command -v jq >/dev/null 2>&1; then
  source="$(cat 2>/dev/null | jq -r '.source // empty' 2>/dev/null || true)"
fi

# The router links siblings relatively — testing.md, git.md — which resolve
# against nothing once this text is pasted into a conversation. Rather than
# rewriting every link, state the directory once and let the model join the two.
preamble="riprap's guardrail documents live in ${DOCS}/ — a relative link below such as \`testing.md\` means \`${DOCS}/testing.md\`. Read them with the Read tool as needed."

# On a continued context, a pointer instead of the whole thing.
#
# Deliberately not silence. The premise — that a resumed or forked context still
# holds the original injection — is a claim about the harness, and if it is ever
# wrong then emitting nothing leaves the session with no guardrails at all. That
# is the failure this repository just spent a release fixing in the other
# direction, when `resume` matched no hook whatsoever. Three lines that name the
# router cost almost nothing and cannot produce that outcome.
case "$source" in
  resume|fork)
    [ "$source" = "fork" ] && started="forked" || started="resumed"
    preamble="riprap's guardrails were injected into this context before it was ${started}, and have not changed. The documents are in ${DOCS}/ — re-read the router at ${DOCS}/README.md if any of it has fallen out of context."
    router=""
    ;;
esac

# Escape for JSON embedding. Each substitution is one C-level pass, which matters
# because this runs on every session start.
escape_for_json() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}

if [ -n "$router" ]; then
  context="$(escape_for_json "${preamble}"$'\n\n'"${router}${handoff_note}")"
else
  context="$(escape_for_json "${preamble}${handoff_note}")"
fi

# Claude Code reads hookSpecificOutput.additionalContext; the SDK standard and
# some other harnesses read a top-level additionalContext. Emitting both would be
# read twice by Claude Code with no deduplication, so pick one.
if [ -n "${CLAUDE_PLUGIN_ROOT:-}" ] && [ -z "${COPILOT_CLI:-}" ]; then
  printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$context"
else
  printf '{\n  "additionalContext": "%s"\n}\n' "$context"
fi

exit 0
