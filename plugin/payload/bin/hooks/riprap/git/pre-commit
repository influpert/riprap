#!/usr/bin/env bash
# riprap's pre-commit checks. Upstream owns this file; `/riprap:install` overwrites
# it. Your own checks belong in bin/hooks/git/pre-commit, which calls this one.
#
# Two jobs: auto-fix what a linter can fix, then run the pattern guardrails
# against what is actually being committed.
#
# Exit codes here are git's convention (1 = reject the commit), NOT the Claude
# hook convention (2 = block the tool call). Same libraries, different callers —
# which is the entire point of keeping the patterns in bin/hooks/riprap/lib.
set -eu

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

# --- 1. Lint and re-stage --------------------------------------------------
# --diff-filter=ACM skips deletions: there is nothing to lint in a file that is
# going away, and passing one to a linter is just an error.
#
# Read into an array with -z (NUL-delimited) rather than splitting a string.
# Filenames with spaces are rare, and a hook that mangles them is the kind of
# bug that surfaces once, confusingly, long after anyone remembers this code.
STAGED=()
while IFS= read -r -d '' f; do
  STAGED+=("$f")
done < <(git diff --cached --name-only --diff-filter=ACM -z || true)

# Files that also have UNSTAGED changes right now. These are the `git add -p`
# cases: someone staged one hunk of a file and deliberately left the rest out.
# Re-staging such a file wholesale would sweep the hunks they excluded into the
# commit — silently changing what they chose to commit. That is the one thing a
# convenience feature must never do, so these are left alone and reported.
PARTIAL=()
while IFS= read -r -d '' f; do
  PARTIAL+=("$f")
done < <(git diff --name-only -z --diff-filter=ACM || true)

is_partial() {
  local f needle="$1"
  for f in ${PARTIAL[@]+"${PARTIAL[@]}"}; do [ "$f" = "$needle" ] && return 0; done
  return 1
}

if [ ${#STAGED[@]} -gt 0 ] && [ -x bin/lint ] && ! grep -q '^# riprap:stub$' bin/lint 2>/dev/null; then
  # Every staged path goes to bin/lint, including ones it has no opinion about.
  # Deciding here which extensions matter would mean this hook knowing the
  # project's stack, which is exactly what bin/lint exists to avoid — so the
  # contract is that bin/lint ignores what it does not handle rather than erroring.
  if ! bin/lint "${STAGED[@]}"; then
    echo "❌ bin/lint failed. Fix the issues, or commit with --no-verify to skip." >&2
    exit 1
  fi

  skipped=()
  for f in "${STAGED[@]}"; do
    [ -f "$f" ] || continue
    if is_partial "$f"; then skipped+=("$f"); continue; fi
    git add -- "$f"     # re-stage whatever the linter fixed
  done

  if [ ${#skipped[@]} -gt 0 ]; then
    {
      echo "ℹ️  Not re-staging these — they have unstaged changes, so you staged them"
      echo "   selectively and re-staging would commit hunks you left out:"
      printf '     %s\n' "${skipped[@]}"
      echo "   If bin/lint changed them, stage that change yourself."
    } >&2
  fi
  echo "✅ lint passed"
fi

# --- 2. Pattern guardrails -------------------------------------------------
# Each rule is registered once here. Adding a guardrail is: write the library,
# write the Claude hook, add one line below.
#
# Scanning strategy per rule matters:
#   - added lines only  -> pre-existing violations do not block unrelated work
#   - whole file        -> needed for co-occurrence and proximity rules
# Secrets use added-lines-only: a secret already committed is a rotation
# problem, not a reason to block today's unrelated commit.

# Sourced $SCRIPT_DIR-relative, not from $REPO_ROOT: this hook has to keep
# working wherever the namespace is mounted, and a path spelled out from the repo
# root has to be edited in every caller the day that changes.
# shellcheck source=../lib/hook-common.sh
. "$SCRIPT_DIR/../lib/hook-common.sh"
# shellcheck source=../lib/secret-patterns.sh
. "$SCRIPT_DIR/../lib/secret-patterns.sh"
# shellcheck source=../lib/tech-footprint-patterns.sh
. "$SCRIPT_DIR/../lib/tech-footprint-patterns.sh"

FAILED=0

# -- secret hygiene: file-level --
#
# The `[@]+` form, not a bare "${STAGED[@]}". Under `set -u`, bash 3.2 — which is
# what macOS ships as /bin/bash — treats an EMPTY array's expansion as an unbound
# variable and aborts. Every other array here is either guarded by a count check
# or already written this way (see is_partial above); this one was neither, so
# `git commit --allow-empty` died at this line with "STAGED[@]: unbound variable"
# before a single check had run.
#
# It failed CLOSED, which is the only reason it was survivable: git saw a
# non-zero hook and refused the commit. It still read like a riprap check having
# an opinion rather than the hook falling over, which is why it sat here. An
# empty commit is the obvious way in, but so is any commit whose staged set is
# empty by the time this runs.
for f in ${STAGED[@]+"${STAGED[@]}"}; do
  if secret_env_file_path "$f"; then
    echo "❌ Refusing to commit a secret-bearing file: $f" >&2
    echo "   Add it to .gitignore. Commit a .example instead." >&2
    FAILED=1
  fi
done

# -- secret hygiene: token values in added lines --
ADDED=$(git diff --cached -U0 | grep -E '^\+' | grep -v '^+++' || true)
if [ -n "$ADDED" ]; then
  HITS=$(secret_scan_text "$ADDED" || true)
  if [ -n "$HITS" ]; then
    {
      echo "❌ Secret token in staged changes (value redacted):"
      echo ""
      echo "$HITS"
      echo ""
      echo "   Remove it and rotate the credential — it is in your reflog either way."
      echo "   If this is a documented example, add 'lint-ok:secrets' to the line."
    } >&2
    FAILED=1
  fi
fi
[ "$FAILED" -eq 0 ] && echo "✅ secret hygiene passed"

# -- tech footprint: a file whose technology nothing in HEAD already uses --
#
# Its own path list, with R included. The lint pass above uses ACM because a
# rename needs no linting, but a rename is one of the ways a technology arrives:
# `git mv main.go main.py` introduces Python and shows up only under R.
TF_STAGED=()
while IFS= read -r -d '' f; do
  TF_STAGED+=("$f")
done < <(git diff --cached --name-only --diff-filter=ACMR -z || true)

# tech_footprint_established fails when there is no baseline to compare against —
# no HEAD, or a HEAD carrying no signal. Both mean the rule has nothing to say.
#
# Every branch below reports. "The check ran and found nothing" and "the check did
# not run" are otherwise indistinguishable in the log, and that indistinguishability
# is precisely what let an earlier version of this hook fail open through review.
if [ ${#TF_STAGED[@]} -eq 0 ]; then
  echo "✅ tech footprint: nothing staged to check"
elif ! TF_ESTABLISHED=$(tech_footprint_established); then
  echo "✅ tech footprint: no established stack in HEAD yet, nothing to depart from"
else
  TF_CANDIDATES=()
  for f in "${TF_STAGED[@]}"; do
    # The escape hatch reads the staged blob: the worktree may carry a marker
    # that is not in what is being committed, or vice versa.
    tech_footprint_staged_exempt "$f" && continue
    TF_CANDIDATES+=("$f")
  done
  TF_HITS=""
  if [ ${#TF_CANDIDATES[@]} -gt 0 ]; then
    TF_HITS=$(tech_footprint_scan_paths "$TF_ESTABLISHED" "${TF_CANDIDATES[@]}" || true)
  fi
  if [ -n "$TF_HITS" ]; then
    {
      echo "❌ These files add a technology this repository does not use:"
      echo ""
      echo "$TF_HITS"
      echo ""
      echo "   Already here: $(tech_footprint_summary "$TF_ESTABLISHED")"
      echo ""
      echo "   A new language or toolchain is a permanent obligation on everyone who"
      echo "   clones this repo, and it does not show up in the diff. Ask first."
      echo "   If it was already agreed, add 'lint-ok:tech-footprint' to the file."
      echo "   See riprap's tech-footprint guardrail (riprap.dev/reference)."
    } >&2
    FAILED=1
  else
    echo "✅ tech footprint unchanged"
  fi
fi

# -- riprap's rules go here; yours go in bin/hooks/git/pre-commit --
# . "$SCRIPT_DIR/../lib/example-patterns.sh"
# for f in "${STAGED[@]}"; do
#   example_relevant_extension "$f" || continue
#   example_path_allowed "$f" && continue
#   [ -f "$f" ] || continue
#   HITS=$(example_scan_text "$(cat "$f")" || true)
#   [ -n "$HITS" ] && { echo "❌ <rule> violation in $f:" >&2; echo "$HITS" >&2; FAILED=1; }
# done

if [ "$FAILED" -ne 0 ]; then
  echo "" >&2
  echo "Commit rejected. Use --no-verify to override, sparingly — bypassing a" >&2
  echo "hook defeats the reason it exists." >&2
  exit 1
fi

exit 0
